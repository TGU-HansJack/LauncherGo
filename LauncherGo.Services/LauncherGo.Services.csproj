<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <EmbeddedAuthModProject>$(MSBuildThisFileDirectory)EmbeddedMods\VsslAuthMod\VsslAuthMod.csproj</EmbeddedAuthModProject>
    <EmbeddedAuthModBuildOutput>$(MSBuildThisFileDirectory)EmbeddedMods\VsslAuthMod\bin\$(Configuration)\net10.0\</EmbeddedAuthModBuildOutput>
    <EmbeddedAuthRoot>$(MSBuildThisFileDirectory)EmbeddedMods\launchergoauth\</EmbeddedAuthRoot>
    <EmbeddedRestrictionModProject>$(MSBuildThisFileDirectory)EmbeddedMods\LauncherGoRestrictionMod\LauncherGoRestrictionMod.csproj</EmbeddedRestrictionModProject>
    <EmbeddedRestrictionModBuildOutput>$(MSBuildThisFileDirectory)EmbeddedMods\LauncherGoRestrictionMod\bin\$(Configuration)\net10.0\</EmbeddedRestrictionModBuildOutput>
    <EmbeddedRestrictionRoot>$(MSBuildThisFileDirectory)EmbeddedMods\launchergorestriction\</EmbeddedRestrictionRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LauncherGo.Abstractions\LauncherGo.Abstractions.csproj" />
    <ProjectReference Include="..\LauncherGo.Domains\LauncherGo.Domains.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="EmbeddedMods\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.1" />
    <PackageReference Include="protobuf-net" Version="3.2.56" />
    <PackageReference Include="System.Management" Version="10.0.8" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.6" />
  </ItemGroup>

  <ItemGroup>
    <None Update="EmbeddedMods\launchergoauth\modinfo.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="EmbeddedMods\launchergoauth\README.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="EmbeddedMods\launchergoauth\serverauth.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('EmbeddedMods\launchergoauth\serverauth.dll')" />
    <None Update="EmbeddedMods\launchergorestriction\modinfo.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="EmbeddedMods\launchergorestriction\README.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="EmbeddedMods\launchergorestriction\launchergorestriction.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('EmbeddedMods\launchergorestriction\launchergorestriction.dll')" />
    <None Update="EmbeddedMods\servermap\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <Target Name="BuildEmbeddedAuthMod" BeforeTargets="BeforeBuild" Condition="'$(BuildEmbeddedAuthMod)' == 'true'">
    <MSBuild Projects="$(EmbeddedAuthModProject)"
             Targets="Restore"
             Properties="Configuration=$(Configuration);VINTAGE_STORY=$(VINTAGE_STORY)" />
    <MSBuild Projects="$(EmbeddedAuthModProject)"
             Targets="Build"
             Properties="Configuration=$(Configuration);VINTAGE_STORY=$(VINTAGE_STORY);NoRestore=true" />
  </Target>

  <Target Name="CopyBuiltEmbeddedAuthModToOutput" AfterTargets="Build" Condition="'$(BuildEmbeddedAuthMod)' == 'true' and Exists('$(EmbeddedAuthModBuildOutput)serverauth.dll')">
    <PropertyGroup>
      <_EmbeddedAuthOutputDir>$(TargetDir)EmbeddedMods\launchergoauth\</_EmbeddedAuthOutputDir>
    </PropertyGroup>
    <MakeDir Directories="$(_EmbeddedAuthOutputDir)" />
    <Copy SourceFiles="$(EmbeddedAuthModBuildOutput)serverauth.dll"
          DestinationFiles="$(_EmbeddedAuthOutputDir)serverauth.dll"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(EmbeddedAuthRoot)modinfo.json;$(EmbeddedAuthRoot)README.txt"
          DestinationFolder="$(_EmbeddedAuthOutputDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="BuildEmbeddedRestrictionMod" BeforeTargets="BeforeBuild" Condition="'$(BuildEmbeddedRestrictionMod)' == 'true'">
    <MSBuild Projects="$(EmbeddedRestrictionModProject)"
             Targets="Restore"
             Properties="Configuration=$(Configuration);VINTAGE_STORY=$(VINTAGE_STORY)" />
    <MSBuild Projects="$(EmbeddedRestrictionModProject)"
             Targets="Build"
             Properties="Configuration=$(Configuration);VINTAGE_STORY=$(VINTAGE_STORY);NoRestore=true" />
  </Target>

  <Target Name="CopyBuiltEmbeddedRestrictionModToOutput" AfterTargets="Build" Condition="'$(BuildEmbeddedRestrictionMod)' == 'true' and Exists('$(EmbeddedRestrictionModBuildOutput)launchergorestriction.dll')">
    <PropertyGroup>
      <_EmbeddedRestrictionOutputDir>$(TargetDir)EmbeddedMods\launchergorestriction\</_EmbeddedRestrictionOutputDir>
    </PropertyGroup>
    <MakeDir Directories="$(_EmbeddedRestrictionOutputDir)" />
    <Copy SourceFiles="$(EmbeddedRestrictionModBuildOutput)launchergorestriction.dll"
          DestinationFiles="$(_EmbeddedRestrictionOutputDir)launchergorestriction.dll"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(EmbeddedRestrictionRoot)modinfo.json;$(EmbeddedRestrictionRoot)README.txt"
          DestinationFolder="$(_EmbeddedRestrictionOutputDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
