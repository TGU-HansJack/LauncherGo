<Window
    x:Class="LauncherGo.Ui.Views.LauncherMainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="980"
    Height="580"
    MinWidth="980"
    MinHeight="580"
    MaxWidth="980"
    MaxHeight="580"
    CanResize="False"
    WindowDecorations="None"
    Background="Transparent"
    TransparencyLevelHint="Transparent"
    TransparencyBackgroundFallback="#FFFFFF"
    Icon="avares://LauncherGo.Ui/Assets/app-icon.ico"
    WindowStartupLocation="CenterScreen"
    x:CompileBindings="False"
    Title="LauncherGo">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WindowSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="WindowBorderBrush" Color="#AAB2BC" />
                    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="FooterBackgroundBrush" Color="#F8F9FA" />
                    <SolidColorBrush x:Key="SplitLineBrush" Color="#E8EAED" />
                    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardHoverBrush" Color="#F3F5F7" />
                    <SolidColorBrush x:Key="CardSelectedBrush" Color="#EAF2FF" />
                    <SolidColorBrush x:Key="MainTextBrush" Color="#111111" />
                    <SolidColorBrush x:Key="SubTextBrush" Color="#6A7380" />
                    <SolidColorBrush x:Key="PrimaryLineBrush" Color="#2D6CDF" />
                    <SolidColorBrush x:Key="SecondaryLineBrush" Color="#16A34A" />
                    <SolidColorBrush x:Key="GridLineBrush" Color="#E3E8EE" />
                    <SolidColorBrush x:Key="NavSelectedBrush" Color="#1677FF" />
                    <SolidColorBrush x:Key="NavSelectedTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="NavNormalTextBrush" Color="#111111" />
                    <SolidColorBrush x:Key="NavDisabledTextBrush" Color="#8A8A8A" />
                    <SolidColorBrush x:Key="LaunchButtonBrush" Color="#8A6500" />
                    <SolidColorBrush x:Key="LaunchButtonHoverBrush" Color="#9A7300" />
                    <SolidColorBrush x:Key="LaunchButtonPressedBrush" Color="#765600" />
                    <SolidColorBrush x:Key="LaunchButtonTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="LaunchSelectionPillBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="LaunchSelectionPillTextBrush" Color="#111111" />
                    <SolidColorBrush x:Key="ControlHoverBrush" Color="#ECEFF2" />
                    <SolidColorBrush x:Key="HeaderIconBrush" Color="#7D8793" />
                    <SolidColorBrush x:Key="HeaderIconHoverBrush" Color="#111111" />
                    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#E5E7EB" />
                    <SolidColorBrush x:Key="ToolTipForegroundBrush" Color="#111111" />
                    <SolidColorBrush x:Key="DropdownHoverBrush" Color="#F1F2F4" />
                    <SolidColorBrush x:Key="DropdownSelectedBrush" Color="#DDEBFF" />
                    <SolidColorBrush x:Key="DropdownSelectedTextBrush" Color="#0F2D62" />
                    <SolidColorBrush x:Key="DownloadActionTextBrush" Color="#111111" />
                    <SolidColorBrush x:Key="DownloadedBadgeTextBrush" Color="#15803D" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WindowSurfaceBrush" Color="#171C22" />
                    <SolidColorBrush x:Key="WindowBorderBrush" Color="#485361" />
                    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#1E252D" />
                    <SolidColorBrush x:Key="FooterBackgroundBrush" Color="#1D242C" />
                    <SolidColorBrush x:Key="SplitLineBrush" Color="#2E3945" />
                    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1A2027" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#232C35" />
                    <SolidColorBrush x:Key="CardHoverBrush" Color="#2B3642" />
                    <SolidColorBrush x:Key="CardSelectedBrush" Color="#2A3F5A" />
                    <SolidColorBrush x:Key="MainTextBrush" Color="#E6EDF6" />
                    <SolidColorBrush x:Key="SubTextBrush" Color="#A0ADBC" />
                    <SolidColorBrush x:Key="PrimaryLineBrush" Color="#7CB3FF" />
                    <SolidColorBrush x:Key="SecondaryLineBrush" Color="#60D394" />
                    <SolidColorBrush x:Key="GridLineBrush" Color="#334050" />
                    <SolidColorBrush x:Key="NavSelectedBrush" Color="#1677FF" />
                    <SolidColorBrush x:Key="NavSelectedTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="NavNormalTextBrush" Color="#E6EDF6" />
                    <SolidColorBrush x:Key="NavDisabledTextBrush" Color="#6F7886" />
                    <SolidColorBrush x:Key="LaunchButtonBrush" Color="#8A6500" />
                    <SolidColorBrush x:Key="LaunchButtonHoverBrush" Color="#9A7300" />
                    <SolidColorBrush x:Key="LaunchButtonPressedBrush" Color="#765600" />
                    <SolidColorBrush x:Key="LaunchButtonTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="LaunchSelectionPillBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="LaunchSelectionPillTextBrush" Color="#111111" />
                    <SolidColorBrush x:Key="ControlHoverBrush" Color="#2D3743" />
                    <SolidColorBrush x:Key="HeaderIconBrush" Color="#B4BDCA" />
                    <SolidColorBrush x:Key="HeaderIconHoverBrush" Color="#E6EDF6" />
                    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#000000" />
                    <SolidColorBrush x:Key="ToolTipForegroundBrush" Color="#F5F5F5" />
                    <SolidColorBrush x:Key="DropdownHoverBrush" Color="#303944" />
                    <SolidColorBrush x:Key="DropdownSelectedBrush" Color="#2D4E7A" />
                    <SolidColorBrush x:Key="DropdownSelectedTextBrush" Color="#EAF2FF" />
                    <SolidColorBrush x:Key="DownloadActionTextBrush" Color="#E6EBF3" />
                    <SolidColorBrush x:Key="DownloadedBadgeTextBrush" Color="#6EE7B7" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Path.IconPath">
            <Setter Property="Fill" Value="{DynamicResource HeaderIconBrush}" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>
        <Style Selector="Path.CloseIconPath">
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="{DynamicResource HeaderIconBrush}" />
            <Setter Property="StrokeThickness" Value="1.3" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>
        <Style Selector="TextBlock#HomeSloganTextBlock">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.TitleButton">
            <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.TitleButton /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.TitleButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.TitleButton:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style Selector="Button.HeaderIconButton">
            <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.HeaderIconButton /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.HeaderIconButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.HeaderIconButton:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.HeaderIconButton:pointerover Path.IconPath">
            <Setter Property="Fill" Value="{DynamicResource HeaderIconHoverBrush}" />
        </Style>
        <Style Selector="Button.HeaderIconButton:pressed Path.IconPath">
            <Setter Property="Fill" Value="{DynamicResource HeaderIconHoverBrush}" />
        </Style>
        <Style Selector="Button#CloseButton:pointerover Path.CloseIconPath">
            <Setter Property="Stroke" Value="{DynamicResource HeaderIconHoverBrush}" />
        </Style>
        <Style Selector="Button#CloseButton:pressed Path.CloseIconPath">
            <Setter Property="Stroke" Value="{DynamicResource HeaderIconHoverBrush}" />
        </Style>
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="{DynamicResource ToolTipBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ToolTipForegroundBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <Style Selector="Button.FooterNavButton">
            <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource NavNormalTextBrush}" />
        </Style>
        <Style Selector="Button.FooterNavButton /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.FooterNavButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        </Style>
        <Style Selector="Button.FooterNavButton.selected">
            <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource NavSelectedTextBrush}" />
        </Style>
        <Style Selector="Button.FooterNavButton.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}" />
        </Style>
        <Style Selector="Button.FooterNavButton:disabled">
            <Setter Property="Foreground" Value="{DynamicResource NavDisabledTextBrush}" />
        </Style>

        <Style Selector="Button.StatusCardButton">
            <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Width" Value="318" />
            <Setter Property="Height" Value="94" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.StatusCardButton /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.StatusCardButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
        </Style>
        <Style Selector="Button.StatusCardButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.StatusCardButton.selected">
            <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.StatusCardButton.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Button#LaunchServerButton">
            <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="146" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="{DynamicResource LaunchButtonBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource LaunchButtonTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CornerRadius" Value="17" />
        </Style>
        <Style Selector="Button#LaunchServerButton /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Background" Value="{DynamicResource LaunchButtonBrush}" />
        </Style>
        <Style Selector="Button#LaunchServerButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource LaunchButtonHoverBrush}" />
        </Style>
        <Style Selector="Button#LaunchServerButton:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource LaunchButtonPressedBrush}" />
        </Style>
        <Style Selector="Border#LaunchSelectionPillHost">
            <Setter Property="Width" Value="0" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.16" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border#LaunchSelectionPillHost.expanded">
            <Setter Property="Width" Value="168" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="ListBox.LaunchChoiceList">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource SplitLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Height" Value="196" />
        </Style>
        <Style Selector="ListBox.LaunchChoiceList ListBoxItem">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style Selector="Button.ActionButton">
            <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="68" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource NavSelectedTextBrush}" />
        </Style>
        <Style Selector="Button.ActionButton /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}" />
        </Style>
        <Style Selector="Button.SecondaryActionButton">
            <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="68" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}" />
        </Style>
        <Style Selector="Button.SecondaryActionButton /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.TextTabButton">
            <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
            <Setter Property="Padding" Value="10,6,10,6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.TextTabButton /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.TextTabButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.TextTabButton.selected">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="{DynamicResource MainTextBrush}" />
        </Style>
        <Style Selector="Button.TextTabButton.selected /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource MainTextBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
        </Style>
        <Style Selector="Button.InlineActionButton">
            <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}" />
        </Style>
        <Style Selector="Button.InlineActionButton:disabled">
            <Setter Property="Foreground" Value="#16A34A" />
        </Style>
        <Style Selector="TextBox.CompactInput">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="ComboBox.CompactCombo">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="ComboBox.CompactCombo:focus-within">
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="ComboBox.CompactCombo:dropdownopen">
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="4,3" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="ClipToBounds" Value="False" />
        </Style>
        <Style Selector="ComboBoxItem:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DropdownHoverBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ComboBoxItem:selected">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DropdownSelectedTextBrush}" />
        </Style>
        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DropdownSelectedBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ComboBox.SettingsGuideCombo">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="MaxHeight" Value="34" />
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox.SettingsGuideCombo:focus-within">
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="ComboBox.SettingsGuideCombo:dropdownopen">
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Border.SectionPanel">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Border.ConfigCard">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="Border.ConfigInnerCard">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style Selector="TextBlock.ConfigSectionTitle">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}" />
        </Style>
        <Style Selector="TextBlock.ConfigFieldLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}" />
        </Style>
        <Style Selector="TextBlock.ConfigHintText">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="StackPanel.ConfigFormField">
            <Setter Property="Width" Value="205" />
            <Setter Property="Spacing" Value="4" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>
        <Style Selector="StackPanel.ConfigFormFieldWide">
            <Setter Property="Width" Value="420" />
            <Setter Property="Spacing" Value="4" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>
        <Style Selector="NumericUpDown.CompactNumber">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="CheckBox.ConfigCheck">
            <Setter Property="Margin" Value="0,4,16,8" />
            <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="ListBox.FlatList">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="SelectableTextBlock#ConsoleOutputTextBlock">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Padding" Value="3,6,3,2" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="SelectionBrush" Value="#FFFFFF" />
            <Setter Property="SelectionForegroundBrush" Value="#000000" />
        </Style>
        <Style Selector="ScrollViewer#ConsoleOutputScrollViewer">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ScrollViewer#ConsoleOutputScrollViewer:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ScrollViewer#ConsoleOutputScrollViewer:focus-within">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBox#DownloadVersionsListBox ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ClipToBounds" Value="False" />
        </Style>
        <Style Selector="ListBox#DownloadVersionsListBox ListBoxItem /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox#DownloadVersionsListBox ListBoxItem:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox#DownloadVersionsListBox ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DropdownHoverBrush}" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="ListBox#DownloadVersionsListBox ListBoxItem:selected">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DropdownSelectedTextBrush}" />
        </Style>
        <Style Selector="ListBox#DownloadVersionsListBox ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DropdownSelectedBrush}" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="ListBox#ProfilesListBox ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ClipToBounds" Value="False" />
        </Style>
        <Style Selector="ListBox#ProfilesListBox ListBoxItem /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox#ProfilesListBox ListBoxItem:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox#ProfilesListBox ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DropdownHoverBrush}" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="ListBox#ProfilesListBox ListBoxItem:selected">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DropdownSelectedTextBrush}" />
        </Style>
        <Style Selector="ListBox#ProfilesListBox ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DropdownSelectedBrush}" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="ListBox#ProfilesListBox TextBlock.ProfileSubText">
            <Setter Property="Opacity" Value="0.82" />
        </Style>
        <Style Selector="ListBox#ProfilesListBox ListBoxItem:selected TextBlock.ProfileSubText">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.DownloadTextButton">
            <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource DownloadActionTextBrush}" />
        </Style>
        <Style Selector="Button.DownloadTextButton:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DownloadActionTextBrush}" />
        </Style>
        <Style Selector="Button.DownloadTextButton:pressed">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource DownloadActionTextBrush}" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </Window.Styles>

    <Grid Background="Transparent">
        <Border CornerRadius="8" Background="{DynamicResource WindowBorderBrush}">
            <Border Margin="1" CornerRadius="7" ClipToBounds="True" Background="{DynamicResource WindowSurfaceBrush}">
                <Grid RowDefinitions="58,*,46">
                    <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="Transparent" BorderThickness="0">
                        <Grid Margin="14,0,10,0" ColumnDefinitions="Auto,*,Auto">
                            <Button x:Name="TitleHomeButton" Classes="TitleButton" Content="LauncherGo" Click="OnHomeNavClick" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button x:Name="RepositoryButton" Classes="HeaderIconButton" Click="OnRepositoryClick" ToolTip.Tip="仓库">
                                    <Viewbox Width="17" Height="17">
                                        <Path Classes="IconPath" Data="M237.9 461.4C237.9 463.4 235.6 465 232.7 465C229.4 465.3 227.1 463.7 227.1 461.4C227.1 459.4 229.4 457.8 232.3 457.8C235.3 457.5 237.9 459.1 237.9 461.4zM206.8 456.9C206.1 458.9 208.1 461.2 211.1 461.8C213.7 462.8 216.7 461.8 217.3 459.8C217.9 457.8 216 455.5 213 454.6C210.4 453.9 207.5 454.9 206.8 456.9zM251 455.2C248.1 455.9 246.1 457.8 246.4 460.1C246.7 462.1 249.3 463.4 252.3 462.7C255.2 462 257.2 460.1 256.9 458.1C256.6 456.2 253.9 454.9 251 455.2zM316.8 72C178.1 72 72 177.3 72 316C72 426.9 141.8 521.8 241.5 555.2C254.3 557.5 258.8 549.6 258.8 543.1C258.8 536.9 258.5 502.7 258.5 481.7C258.5 481.7 188.5 496.7 173.8 451.9C173.8 451.9 162.4 422.8 146 415.3C146 415.3 123.1 399.6 147.6 399.9C147.6 399.9 172.5 401.9 186.2 425.7C208.1 464.3 244.8 453.2 259.1 446.6C261.4 430.6 267.9 419.5 275.1 412.9C219.2 406.7 162.8 398.6 162.8 302.4C162.8 274.9 170.4 261.1 186.4 243.5C183.8 237 175.3 210.2 189 175.6C209.9 169.1 258 202.6 258 202.6C278 197 299.5 194.1 320.8 194.1C342.1 194.1 363.6 197 383.6 202.6C383.6 202.6 431.7 169 452.6 175.6C466.3 210.3 457.8 237 455.2 243.5C471.2 261.2 481 275 481 302.4C481 398.9 422.1 406.6 366.2 412.9C375.4 420.8 383.2 435.8 383.2 459.3C383.2 493 382.9 534.7 382.9 542.9C382.9 549.4 387.5 557.3 400.2 555C500.2 521.8 568 426.9 568 316C568 177.3 455.5 72 316.8 72zM169.2 416.9C167.9 417.9 168.2 420.2 169.9 422.1C171.5 423.7 173.8 424.4 175.1 423.1C176.4 422.1 176.1 419.8 174.4 417.9C172.8 416.3 170.5 415.6 169.2 416.9zM158.4 408.8C157.7 410.1 158.7 411.7 160.7 412.7C162.3 413.7 164.3 413.4 165 412C165.7 410.7 164.7 409.1 162.7 408.1C160.7 407.5 159.1 407.8 158.4 408.8zM190.8 444.4C189.2 445.7 189.8 448.7 192.1 450.6C194.4 452.9 197.3 453.2 198.6 451.6C199.9 450.3 199.3 447.3 197.3 445.4C195.1 443.1 192.1 442.8 190.8 444.4zM179.4 429.7C177.8 430.7 177.8 433.3 179.4 435.6C181 437.9 183.7 438.9 185 437.9C186.6 436.6 186.6 434 185 431.7C183.6 429.4 181 428.4 179.4 429.7z" />
                                    </Viewbox>
                                </Button>
                                <Button x:Name="FeedbackButton" Classes="HeaderIconButton" Click="OnFeedbackClick" ToolTip.Tip="反馈">
                                    <Viewbox Width="17" Height="17">
                                        <Path Classes="IconPath" Data="M176 168C189.3 168 200 157.3 200 144C200 130.7 189.3 120 176 120C162.7 120 152 130.7 152 144C152 157.3 162.7 168 176 168zM256 144C256 176.8 236.3 205 208 217.3L208 288L384 288C410.5 288 432 266.5 432 240L432 217.3C403.7 205 384 176.8 384 144C384 99.8 419.8 64 464 64C508.2 64 544 99.8 544 144C544 176.8 524.3 205 496 217.3L496 240C496 301.9 445.9 352 384 352L208 352L208 422.7C236.3 435 256 463.2 256 496C256 540.2 220.2 576 176 576C131.8 576 96 540.2 96 496C96 463.2 115.7 435 144 422.7L144 217.4C115.7 205 96 176.8 96 144C96 99.8 131.8 64 176 64C220.2 64 256 99.8 256 144zM488 144C488 130.7 477.3 120 464 120C450.7 120 440 130.7 440 144C440 157.3 450.7 168 464 168C477.3 168 488 157.3 488 144zM176 520C189.3 520 200 509.3 200 496C200 482.7 189.3 472 176 472C162.7 472 152 482.7 152 496C152 509.3 162.7 520 176 520z" />
                                    </Viewbox>
                                </Button>
                                <Button x:Name="SponsorButton" Classes="HeaderIconButton" Click="OnSponsorClick" ToolTip.Tip="赞助">
                                    <Viewbox Width="17" Height="17">
                                        <Path Classes="IconPath" Data="M311.6 95C297.5 75.5 274.9 64 250.9 64C209.5 64 176 97.5 176 138.9L176 141.3C176 205.7 258 274.7 298.2 304.6C311.2 314.3 328.7 314.3 341.7 304.6C381.9 274.6 463.9 205.7 463.9 141.3L463.9 138.9C463.9 97.5 430.4 64 389 64C365 64 342.4 75.5 328.3 95L320 106.7L311.6 95zM141.3 405.5L98.7 448L64 448C46.3 448 32 462.3 32 480L32 544C32 561.7 46.3 576 64 576L384.5 576C413.5 576 441.8 566.7 465.2 549.5L591.8 456.2C609.6 443.1 613.4 418.1 600.3 400.3C587.2 382.5 562.2 378.7 544.4 391.8L424.6 480L312 480C298.7 480 288 469.3 288 456C288 442.7 298.7 432 312 432L384 432C401.7 432 416 417.7 416 400C416 382.3 401.7 368 384 368L231.8 368C197.9 368 165.3 381.5 141.3 405.5z" />
                                    </Viewbox>
                                </Button>
                                <Button x:Name="CloseButton" Classes="HeaderIconButton" Click="OnCloseClick" ToolTip.Tip="关闭">
                                    <Viewbox Width="14" Height="14">
                                        <Path Classes="CloseIconPath" Data="M18 6L6 18M6 6L18 18" />
                                    </Viewbox>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Background="{DynamicResource WindowSurfaceBrush}" Margin="24,6,24,8">
                        <Grid Margin="0">
                            <Grid x:Name="HomePanel" ColumnDefinitions="*,360" ColumnSpacing="30">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="10">
                                    <TextBlock
                                        x:Name="HomeSloganTextBlock"
                                        FontSize="32"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource MainTextBrush}"
                                        TextWrapping="Wrap"
                                        Opacity="1" />
                                </StackPanel>

                                <Grid Grid.Column="1" Width="286" Height="286" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="False">
                                    <Viewbox Width="274" Height="274" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid Width="800" Height="800" ClipToBounds="False">
                                            <Canvas Width="800" Height="800" Opacity="0.76">
                                                <Rectangle Width="200" Height="200" Canvas.Left="126" Canvas.Top="259" Fill="#3C000000" RadiusX="12" RadiusY="12" />
                                                <Rectangle Width="200" Height="200" Canvas.Left="526" Canvas.Top="259" Fill="#3C000000" RadiusX="12" RadiusY="12" />
                                                <Rectangle Width="200" Height="200" Canvas.Left="326" Canvas.Top="459" Fill="#3C000000" RadiusX="12" RadiusY="12" />
                                            </Canvas>
                                            <Canvas Width="800" Height="800">
                                                <Rectangle Width="200" Height="200" Canvas.Left="100" Canvas.Top="233" Fill="#6b8e23" RadiusX="12" RadiusY="12" />
                                                <Rectangle Width="200" Height="200" Canvas.Left="500" Canvas.Top="233" Fill="#8b5a2b" RadiusX="12" RadiusY="12" />
                                                <Rectangle Width="200" Height="200" Canvas.Left="300" Canvas.Top="433" Fill="#555555" RadiusX="12" RadiusY="12" />
                                                <Rectangle Width="176" Height="18" Canvas.Left="112" Canvas.Top="245" Fill="#22FFFFFF" RadiusX="8" RadiusY="8" />
                                                <Rectangle Width="176" Height="18" Canvas.Left="512" Canvas.Top="245" Fill="#20FFFFFF" RadiusX="8" RadiusY="8" />
                                                <Rectangle Width="176" Height="18" Canvas.Left="312" Canvas.Top="445" Fill="#1EFFFFFF" RadiusX="8" RadiusY="8" />
                                            </Canvas>
                                            <Canvas Width="800" Height="800" Opacity="0.6">
                                                <Rectangle Width="200" Height="200" Canvas.Left="100" Canvas.Top="233" RadiusX="12" RadiusY="12">
                                                    <Rectangle.Fill>
                                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                            <GradientStop Color="#00FFFFFF" Offset="0" />
                                                            <GradientStop Color="#55FFFFFF" Offset="0.48" />
                                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Rectangle.Fill>
                                                </Rectangle>
                                                <Rectangle Width="200" Height="200" Canvas.Left="500" Canvas.Top="233" RadiusX="12" RadiusY="12">
                                                    <Rectangle.Fill>
                                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                            <GradientStop Color="#00FFFFFF" Offset="0" />
                                                            <GradientStop Color="#4DFFFFFF" Offset="0.48" />
                                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Rectangle.Fill>
                                                </Rectangle>
                                                <Rectangle Width="200" Height="200" Canvas.Left="300" Canvas.Top="433" RadiusX="12" RadiusY="12">
                                                    <Rectangle.Fill>
                                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                            <GradientStop Color="#00FFFFFF" Offset="0" />
                                                            <GradientStop Color="#44FFFFFF" Offset="0.48" />
                                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Rectangle.Fill>
                                                </Rectangle>
                                            </Canvas>
                                        </Grid>
                                    </Viewbox>
                                </Grid>
                            </Grid>

                            <Grid x:Name="MonitorPanel" ColumnDefinitions="330,*" ColumnSpacing="12" IsVisible="False">
                                <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" VerticalAlignment="Top">
                                    <Button x:Name="ServerStatusCard" Grid.Row="0" Classes="StatusCardButton" Click="OnServerStatusCardClick">
                                        <Grid ColumnDefinitions="78,*" ColumnSpacing="12">
                                            <Border Width="76" Height="50" BorderBrush="#111111" BorderThickness="1" Background="Transparent">
                                                <Canvas Width="76" Height="50" Background="Transparent" ClipToBounds="True">
                                                    <Polyline x:Name="ServerStatusThumbLinePrimary" Stroke="{DynamicResource PrimaryLineBrush}" StrokeThickness="1.4" />
                                                    <Polyline x:Name="ServerStatusThumbLineSecondary" Stroke="{DynamicResource SecondaryLineBrush}" StrokeThickness="1.4" />
                                                </Canvas>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock x:Name="ServerStatusCardTitleText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" />
                                                <TextBlock x:Name="ServerStatusCardValueText" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="RobotStatusCard" Grid.Row="1" Classes="StatusCardButton" Click="OnRobotStatusCardClick">
                                        <Grid ColumnDefinitions="78,*" ColumnSpacing="12">
                                            <Border Width="76" Height="50" BorderBrush="#111111" BorderThickness="1" Background="Transparent">
                                                <Canvas Width="76" Height="50" Background="Transparent" ClipToBounds="True">
                                                    <Polyline x:Name="RobotStatusThumbLinePrimary" Stroke="{DynamicResource PrimaryLineBrush}" StrokeThickness="1.4" />
                                                    <Polyline x:Name="RobotStatusThumbLineSecondary" Stroke="{DynamicResource SecondaryLineBrush}" StrokeThickness="1.4" />
                                                </Canvas>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock x:Name="RobotStatusCardTitleText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" />
                                                <TextBlock x:Name="RobotStatusCardValueText" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="OnlinePlayersCard" Grid.Row="2" Classes="StatusCardButton" Click="OnOnlinePlayersCardClick">
                                        <Grid ColumnDefinitions="78,*" ColumnSpacing="12">
                                            <Border Width="76" Height="50" BorderBrush="#111111" BorderThickness="1" Background="Transparent">
                                                <Canvas Width="76" Height="50" Background="Transparent" ClipToBounds="True">
                                                    <Polyline x:Name="OnlinePlayersThumbLinePrimary" Stroke="{DynamicResource PrimaryLineBrush}" StrokeThickness="1.4" />
                                                </Canvas>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock x:Name="OnlinePlayersCardTitleText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" />
                                                <TextBlock x:Name="OnlinePlayersCardValueText" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="NetworkStatusCard" Grid.Row="3" Classes="StatusCardButton" Click="OnNetworkStatusCardClick">
                                        <Grid ColumnDefinitions="78,*" ColumnSpacing="12">
                                            <Border Width="76" Height="50" BorderBrush="#111111" BorderThickness="1" Background="Transparent">
                                                <Canvas Width="76" Height="50" Background="Transparent" ClipToBounds="True">
                                                    <Polyline x:Name="NetworkStatusThumbLinePrimary" Stroke="{DynamicResource PrimaryLineBrush}" StrokeThickness="1.4" />
                                                </Canvas>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock x:Name="NetworkStatusCardTitleText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" />
                                                <TextBlock x:Name="NetworkStatusCardValueText" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </Grid>

                                <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0" Padding="12">
                                    <Grid RowDefinitions="Auto,*,Auto,Auto">
                                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                            <TextBlock x:Name="ChartTitleText" Grid.Row="0" Grid.Column="0" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" />
                                            <TextBlock x:Name="ChartTopValueText" Grid.Row="0" Grid.Column="1" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" VerticalAlignment="Bottom" />
                                            <TextBlock x:Name="ChartSummaryText" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0" FontSize="13" Foreground="{DynamicResource SubTextBrush}" />
                                        </Grid>

                                        <Grid Grid.Row="1" Margin="0,10,0,10" RowDefinitions="*,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                            <Grid Grid.Row="0" Grid.Column="0" Width="50" RowDefinitions="*,*,*,*,*,*" VerticalAlignment="Stretch">
                                                <TextBlock x:Name="YAxisLabelTop" Grid.Row="0" FontSize="11" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                <TextBlock x:Name="YAxisLabel2" Grid.Row="1" FontSize="11" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock x:Name="YAxisLabel3" Grid.Row="2" FontSize="11" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock x:Name="YAxisLabel4" Grid.Row="3" FontSize="11" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock x:Name="YAxisLabel5" Grid.Row="4" FontSize="11" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock x:Name="YAxisLabelBottom" Grid.Row="5" FontSize="11" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                            </Grid>
                                            <Border Grid.Row="0" Grid.Column="1" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0" Padding="8">
                                                <Viewbox Stretch="Fill">
                                                    <Canvas x:Name="ChartCanvas" Width="640" Height="248" Background="Transparent">
                                                        <Line StartPoint="0,0" EndPoint="640,0" Stroke="{DynamicResource GridLineBrush}" StrokeThickness="1" />
                                                        <Line StartPoint="0,50" EndPoint="640,50" Stroke="{DynamicResource GridLineBrush}" StrokeThickness="1" />
                                                        <Line StartPoint="0,100" EndPoint="640,100" Stroke="{DynamicResource GridLineBrush}" StrokeThickness="1" />
                                                        <Line StartPoint="0,150" EndPoint="640,150" Stroke="{DynamicResource GridLineBrush}" StrokeThickness="1" />
                                                        <Line StartPoint="0,200" EndPoint="640,200" Stroke="{DynamicResource GridLineBrush}" StrokeThickness="1" />
                                                        <Line StartPoint="0,248" EndPoint="640,248" Stroke="{DynamicResource GridLineBrush}" StrokeThickness="1" />

                                                        <Polyline x:Name="ChartLinePrimary" Stroke="{DynamicResource PrimaryLineBrush}" StrokeThickness="2" />
                                                        <Polyline x:Name="ChartLineSecondary" Stroke="{DynamicResource SecondaryLineBrush}" StrokeThickness="2" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>
                                            <TextBlock x:Name="ChartXAxisText" Grid.Row="1" Grid.Column="1" Margin="4,6,0,0" FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
                                        </Grid>

                                        <Grid x:Name="ChartDetailGrid" Grid.Row="2" Margin="0,0,0,8" ColumnDefinitions="*,*,*,*" RowDefinitions="Auto" ColumnSpacing="16">
                                            <StackPanel>
                                                <TextBlock x:Name="DetailOneLabelText" FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
                                                <TextBlock x:Name="DetailOneValueText" FontSize="18" Foreground="{DynamicResource MainTextBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock x:Name="DetailTwoLabelText" FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
                                                <TextBlock x:Name="DetailTwoValueText" FontSize="18" Foreground="{DynamicResource MainTextBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock x:Name="DetailThreeLabelText" FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
                                                <TextBlock x:Name="DetailThreeValueText" FontSize="18" Foreground="{DynamicResource MainTextBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3">
                                                <TextBlock x:Name="DetailFourLabelText" FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
                                                <TextBlock x:Name="DetailFourValueText" FontSize="18" Foreground="{DynamicResource MainTextBrush}" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Grid.Row="3" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0" Padding="8" IsVisible="False" x:Name="EventTickerContainer">
                                            <Grid Height="24" ClipToBounds="True">
                                                <TextBlock x:Name="EventTickerCurrentText" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource MainTextBrush}" TextTrimming="CharacterEllipsis" RenderTransform="translate(0px,0px)">
                                                    <TextBlock.Transitions>
                                                        <Transitions>
                                                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" />
                                                        </Transitions>
                                                    </TextBlock.Transitions>
                                                </TextBlock>
                                                <TextBlock x:Name="EventTickerNextText" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource MainTextBrush}" TextTrimming="CharacterEllipsis" RenderTransform="translate(0px,24px)">
                                                    <TextBlock.Transitions>
                                                        <Transitions>
                                                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" />
                                                        </Transitions>
                                                    </TextBlock.Transitions>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid x:Name="ConsolePanel" RowDefinitions="*,Auto" RowSpacing="8" IsVisible="False" Margin="-24,-6,-24,0">
                                <Border Classes="SectionPanel" Background="#000000">
                                    <ScrollViewer
                                        x:Name="ConsoleOutputScrollViewer"
                                        Margin="12,0,12,0"
                                        HorizontalScrollBarVisibility="Hidden"
                                        VerticalScrollBarVisibility="Hidden">
                                        <SelectableTextBlock
                                            x:Name="ConsoleOutputTextBlock"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            Foreground="#FFFFFF"
                                            TextWrapping="NoWrap"
                                            SelectionBrush="#FFFFFF"
                                            SelectionForegroundBrush="#000000" />
                                    </ScrollViewer>
                                </Border>
                                <Grid Grid.Row="1" Margin="24,0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <TextBox x:Name="CommandTextBox" Classes="CompactInput" PlaceholderText="输入服务器命令，回车发送" KeyDown="OnCommandTextBoxKeyDown" />
                                    <ComboBox
                                        x:Name="QuickCommandComboBox"
                                        Grid.Column="1"
                                        Width="170"
                                        Classes="CompactCombo"
                                        PlaceholderText="快捷命令"
                                        SelectionChanged="OnQuickCommandSelectionChanged" />
                                    <Button x:Name="SendCommandButton" Grid.Column="2" Classes="ActionButton" Content="发送" Click="OnSendCommandClick" />
                                </Grid>
                            </Grid>

                            <Grid x:Name="InstanceManagePanel" RowDefinitions="Auto,*" RowSpacing="10" IsVisible="False">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <Button x:Name="ProfilesTabButton" Classes="TextTabButton" Content="档案列表" Click="OnProfilesSubTabClick" />
                                    <Button x:Name="ConfigTabButton" Classes="TextTabButton" Content="配置" Click="OnConfigSubTabClick" />
                                    <Button x:Name="SavesTabButton" Classes="TextTabButton" Content="存档管理" Click="OnSavesSubTabClick" />
                                    <Button x:Name="DownloadVersionsTabButton" Classes="TextTabButton" Content="下载版本" Click="OnDownloadVersionsSubTabClick" />
                                </StackPanel>

                                <Grid Grid.Row="1">
                                    <Grid x:Name="ProfilesPanel" RowDefinitions="Auto,*" RowSpacing="10">
                                        <Grid ColumnDefinitions="Auto,180,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                                            <ComboBox x:Name="CreateVersionComboBox" Grid.Column="0" Classes="CompactCombo" />
                                            <TextBox x:Name="ProfileNameTextBox" Grid.Column="1" Classes="CompactInput" PlaceholderText="档案名称" />
                                            <Button x:Name="CreateProfileButton" Grid.Column="2" Classes="ActionButton" Content="创建" Click="OnCreateProfileClick" />
                                            <Button x:Name="ImportProfileButton" Grid.Column="3" Classes="SecondaryActionButton" Content="导入" Click="OnImportProfileClick" />
                                            <Button x:Name="DeleteProfileButton" Grid.Column="4" Classes="SecondaryActionButton" Content="删除" Click="OnDeleteProfilesClick" />
                                            <Button x:Name="RefreshProfilesButton" Grid.Column="5" Classes="SecondaryActionButton" Content="刷新" Click="OnRefreshProfilesClick" />
                                        </Grid>
                                        <ListBox x:Name="ProfilesListBox" Grid.Row="1" Classes="FlatList" SelectionMode="Multiple">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="3">
                                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Version}" FontSize="13" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="ProfileSubText" Text="{Binding DirectoryPath}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="ProfileSubText" Text="{Binding ActiveSaveFile}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>

                                    <Grid x:Name="ConfigPanel" RowDefinitions="Auto,Auto,*" RowSpacing="8" IsVisible="False">
                                        <Grid ColumnDefinitions="260,Auto,Auto,Auto,*" ColumnSpacing="8">
                                            <ComboBox x:Name="ConfigProfileComboBox" Grid.Column="0" Classes="CompactCombo" SelectionChanged="OnConfigProfileSelectionChanged">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button x:Name="ConfigRefreshButton" Grid.Column="1" Classes="SecondaryActionButton" Content="刷新" Click="OnConfigRefreshClick" />
                                            <Button x:Name="ConfigImportButton" Grid.Column="2" Classes="SecondaryActionButton" Content="导入" Click="OnConfigImportClick" />
                                            <Button x:Name="ConfigSaveButton" Grid.Column="3" Classes="ActionButton" Content="保存" Click="OnConfigSaveClick" />
                                        </Grid>

                                        <TextBlock x:Name="ConfigStatusTextBlock" Grid.Row="1" FontSize="12" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" />

                                        <Grid Grid.Row="2">
                                            <ScrollViewer x:Name="ConfigScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                                <StackPanel x:Name="ConfigContentHost" Spacing="10">
                                                    <Border Classes="ConfigCard">
                                                        <StackPanel Spacing="10">
                                                            <TextBlock x:Name="ConfigBasicInfoTitleTextBlock" Classes="ConfigSectionTitle" Text="基础信息" />
                                                            <WrapPanel Orientation="Horizontal">
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigServerNameLabelTextBlock" Classes="ConfigFieldLabel" Text="服务器名称" />
                                                                    <TextBox x:Name="ConfigServerNameTextBox" Classes="CompactInput" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigServerLanguageLabelTextBlock" Classes="ConfigFieldLabel" Text="服务器语言" />
                                                                    <ComboBox x:Name="ConfigServerLanguageComboBox" Classes="CompactCombo" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigDefaultRoleCodeLabelTextBlock" Classes="ConfigFieldLabel" Text="默认角色代码" />
                                                                    <ComboBox x:Name="ConfigDefaultRoleComboBox" Classes="CompactCombo" SelectionChanged="OnConfigDefaultRoleSelectionChanged">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                    <TextBox x:Name="ConfigDefaultRoleCodeTextBox" Classes="CompactInput" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormFieldWide">
                                                                    <TextBlock x:Name="ConfigServerDescriptionLabelTextBlock" Classes="ConfigFieldLabel" Text="服务器描述" />
                                                                    <TextBox x:Name="ConfigServerDescriptionTextBox" Height="64" AcceptsReturn="True" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormFieldWide">
                                                                    <TextBlock x:Name="ConfigWelcomeMessageLabelTextBlock" Classes="ConfigFieldLabel" Text="进服提示" />
                                                                    <TextBox x:Name="ConfigWelcomeMessageTextBox" Classes="CompactInput" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Classes="ConfigCard">
                                                        <StackPanel Spacing="10">
                                                            <TextBlock x:Name="ConfigNetworkTitleTextBlock" Classes="ConfigSectionTitle" Text="网络与公开" />
                                                            <WrapPanel Orientation="Horizontal">
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigIpLabelTextBlock" Classes="ConfigFieldLabel" Text="IP" />
                                                                    <TextBox x:Name="ConfigIpTextBox" Classes="CompactInput" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigPortLabelTextBlock" Classes="ConfigFieldLabel" Text="端口" />
                                                                    <NumericUpDown x:Name="ConfigPortNumericUpDown" Classes="CompactNumber" Minimum="1" Maximum="65535" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigMaxClientsLabelTextBlock" Classes="ConfigFieldLabel" Text="最大玩家数" />
                                                                    <NumericUpDown x:Name="ConfigMaxClientsNumericUpDown" Classes="CompactNumber" Minimum="1" Maximum="200" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigMaxClientsInQueueLabelTextBlock" Classes="ConfigFieldLabel" Text="排队人数上限" />
                                                                    <NumericUpDown x:Name="ConfigMaxClientsInQueueNumericUpDown" Classes="CompactNumber" Minimum="0" Maximum="200" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormFieldWide">
                                                                    <TextBlock x:Name="ConfigServerUrlLabelTextBlock" Classes="ConfigFieldLabel" Text="服务器网址" />
                                                                    <TextBox x:Name="ConfigServerUrlTextBox" Classes="CompactInput" />
                                                                </StackPanel>
                                                                <CheckBox x:Name="ConfigAdvertiseServerCheckBox" Classes="ConfigCheck" Content="公开到服务器列表" />
                                                                <CheckBox x:Name="ConfigUpnpCheckBox" Classes="ConfigCheck" Content="启用 UPnP 自动端口映射" />
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Classes="ConfigCard">
                                                        <StackPanel Spacing="10">
                                                            <TextBlock x:Name="ConfigSecurityTitleTextBlock" Classes="ConfigSectionTitle" Text="安全与维护" />
                                                            <WrapPanel Orientation="Horizontal">
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigPasswordLabelTextBlock" Classes="ConfigFieldLabel" Text="加入密码" />
                                                                    <TextBox x:Name="ConfigPasswordTextBox" Classes="CompactInput" PasswordChar="*" />
                                                                    <TextBlock x:Name="ConfigPasswordHintTextBlock" Classes="ConfigHintText" Text="留空表示不设置密码。" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigWhitelistModeLabelTextBlock" Classes="ConfigFieldLabel" Text="白名单模式" />
                                                                    <ComboBox x:Name="ConfigWhitelistModeComboBox" Classes="CompactCombo">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigWarnAfkSecondsLabelTextBlock" Classes="ConfigFieldLabel" Text="AFK 警告秒数" />
                                                                    <NumericUpDown x:Name="ConfigWarnAfkSecondsNumericUpDown" Classes="CompactNumber" Minimum="0" Maximum="86400" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigKickAfkSecondsLabelTextBlock" Classes="ConfigFieldLabel" Text="AFK 踢出秒数" />
                                                                    <NumericUpDown x:Name="ConfigKickAfkSecondsNumericUpDown" Classes="CompactNumber" Minimum="0" Maximum="86400" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigClientConnectionTimeoutLabelTextBlock" Classes="ConfigFieldLabel" Text="连接超时秒数" />
                                                                    <NumericUpDown x:Name="ConfigClientConnectionTimeoutNumericUpDown" Classes="CompactNumber" Minimum="1" Maximum="3600" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigMaxChunkRadiusLabelTextBlock" Classes="ConfigFieldLabel" Text="最大区块视距半径" />
                                                                    <NumericUpDown x:Name="ConfigMaxChunkRadiusNumericUpDown" Classes="CompactNumber" Minimum="1" Maximum="64" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigDieBelowDiskSpaceMbLabelTextBlock" Classes="ConfigFieldLabel" Text="低于磁盘空间时关闭（MB）" />
                                                                    <NumericUpDown x:Name="ConfigDieBelowDiskSpaceMbNumericUpDown" Classes="CompactNumber" Minimum="-1" Maximum="1048576" />
                                                                </StackPanel>
                                                                <CheckBox x:Name="ConfigVerifyPlayerAuthCheckBox" Classes="ConfigCheck" Content="启用官方账号验证" />
                                                                <CheckBox x:Name="ConfigAllowPvPCheckBox" Classes="ConfigCheck" Content="允许PvP" />
                                                                <CheckBox x:Name="ConfigAllowFireSpreadCheckBox" Classes="ConfigCheck" Content="允许火势蔓延" />
                                                                <CheckBox x:Name="ConfigAllowFallingBlocksCheckBox" Classes="ConfigCheck" Content="允许方块掉落" />
                                                                <CheckBox x:Name="ConfigPassTimeWhenEmptyCheckBox" Classes="ConfigCheck" Content="无人在线时继续流逝时间" />
                                                                <CheckBox x:Name="ConfigCorruptionProtectionCheckBox" Classes="ConfigCheck" Content="启用存档损坏保护" />
                                                                <CheckBox x:Name="ConfigRegenerateCorruptChunksCheckBox" Classes="ConfigCheck" Content="重新生成损坏区块" />
                                                                <StackPanel Classes="ConfigFormFieldWide">
                                                                    <TextBlock x:Name="ConfigStartupCommandsLabelTextBlock" Classes="ConfigFieldLabel" Text="启动后执行命令" />
                                                                    <TextBox x:Name="ConfigStartupCommandsTextBox" Height="74" AcceptsReturn="True" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Classes="ConfigCard">
                                                        <StackPanel Spacing="10">
                                                            <TextBlock x:Name="ConfigWorldTitleTextBlock" Classes="ConfigSectionTitle" Text="世界" />
                                                            <WrapPanel Orientation="Horizontal">
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigSeedLabelTextBlock" Classes="ConfigFieldLabel" Text="种子" />
                                                                    <TextBox x:Name="ConfigSeedTextBox" Classes="CompactInput" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigWorldNameLabelTextBlock" Classes="ConfigFieldLabel" Text="世界名称" />
                                                                    <TextBox x:Name="ConfigWorldNameTextBox" Classes="CompactInput" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigSaveFileLabelTextBlock" Classes="ConfigFieldLabel" Text="存档文件" />
                                                                    <ComboBox x:Name="ConfigSaveFileComboBox" Classes="CompactCombo" SelectionChanged="OnConfigSaveFileSelectionChanged">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigPlayStyleLabelTextBlock" Classes="ConfigFieldLabel" Text="游玩风格" />
                                                                    <ComboBox x:Name="ConfigPlayStyleComboBox" Classes="CompactCombo">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigWorldTypeLabelTextBlock" Classes="ConfigFieldLabel" Text="世界类型" />
                                                                    <ComboBox x:Name="ConfigWorldTypeComboBox" Classes="CompactCombo">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigWorldHeightLabelTextBlock" Classes="ConfigFieldLabel" Text="世界高度" />
                                                                    <NumericUpDown x:Name="ConfigWorldHeightNumericUpDown" Classes="CompactNumber" Minimum="64" Maximum="2048" />
                                                                </StackPanel>
                                                            </WrapPanel>
                                                            <TextBlock x:Name="ConfigWorldGeneratedNoticeTextBlock" Classes="ConfigHintText" IsVisible="False" Text="当前存档已生成世界：建档阶段配置已锁定。" />
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Classes="ConfigCard">
                                                        <StackPanel Spacing="10">
                                                            <TextBlock x:Name="ConfigServerImagesTitleTextBlock" Classes="ConfigSectionTitle" Text="服务器图片" />
                                                            <StackPanel Spacing="3">
                                                                <TextBlock x:Name="ConfigServerImagesRootLabelTextBlock" Classes="ConfigFieldLabel" Text="图片目录" />
                                                                <TextBlock x:Name="ConfigImageRootPathTextBlock" Classes="ConfigHintText" />
                                                            </StackPanel>
                                                            <WrapPanel Orientation="Horizontal">
                                                                <Border Classes="ConfigInnerCard" Width="380" Margin="0,0,10,10">
                                                                    <StackPanel Spacing="8">
                                                                        <TextBlock x:Name="ConfigCoverTitleTextBlock" Classes="ConfigFieldLabel" Text="封面图（cover）" />
                                                                        <TextBlock x:Name="ConfigCoverImageTextBlock" Classes="ConfigHintText" Text="暂无封面图。" />
                                                                        <TextBlock x:Name="ConfigPendingCoverImportTextBlock" Classes="ConfigHintText" />
                                                                        <WrapPanel Orientation="Horizontal">
                                                                            <Button x:Name="ConfigCoverBrowseButton" Classes="SecondaryActionButton" Margin="0,0,6,6" Content="浏览" Click="OnConfigCoverBrowseClick" />
                                                                            <Button x:Name="ConfigCoverImportButton" Classes="SecondaryActionButton" Margin="0,0,6,6" Content="导入" Click="OnConfigCoverImportClick" />
                                                                            <Button x:Name="ConfigCoverPreviewButton" Classes="SecondaryActionButton" Margin="0,0,6,6" Content="预览" Click="OnConfigCoverPreviewClick" />
                                                                            <Button x:Name="ConfigCoverDeleteButton" Classes="SecondaryActionButton" Margin="0,0,6,6" Content="删除" Click="OnConfigCoverDeleteClick" />
                                                                        </WrapPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border Classes="ConfigInnerCard" Width="430" Margin="0,0,10,10">
                                                                    <StackPanel Spacing="8">
                                                                        <TextBlock x:Name="ConfigShowcaseTitleTextBlock" Classes="ConfigFieldLabel" Text="展示图（showcase）" />
                                                                        <TextBlock x:Name="ConfigShowcaseHintTextBlock" Classes="ConfigHintText" Text="选择列表项后可预览。" />
                                                                        <TextBlock x:Name="ConfigNoShowcaseTextBlock" Classes="ConfigHintText" Text="暂无展示图。" />
                                                                        <ListBox x:Name="ConfigShowcaseImagesListBox" MaxHeight="150" Classes="FlatList">
                                                                            <ListBox.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <StackPanel Spacing="2" Margin="0,3">
                                                                                        <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" TextTrimming="CharacterEllipsis" />
                                                                                        <TextBlock Text="{Binding RelativePath}" FontSize="12" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
                                                                                        <TextBlock Text="{Binding SizeLabel}" FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
                                                                                    </StackPanel>
                                                                                </DataTemplate>
                                                                            </ListBox.ItemTemplate>
                                                                        </ListBox>
                                                                        <TextBlock x:Name="ConfigPendingShowcaseImportTextBlock" Classes="ConfigHintText" />
                                                                        <WrapPanel Orientation="Horizontal">
                                                                            <Button x:Name="ConfigShowcaseBrowseButton" Classes="SecondaryActionButton" Margin="0,0,6,6" Content="浏览" Click="OnConfigShowcaseBrowseClick" />
                                                                            <Button x:Name="ConfigShowcaseAddButton" Classes="SecondaryActionButton" Margin="0,0,6,6" Content="添加" Click="OnConfigShowcaseAddClick" />
                                                                            <Button x:Name="ConfigShowcaseImportFolderButton" Classes="SecondaryActionButton" Margin="0,0,6,6" Content="导入" Click="OnConfigShowcaseImportFolderClick" />
                                                                            <Button x:Name="ConfigShowcasePreviewButton" Classes="SecondaryActionButton" Margin="0,0,6,6" Content="预览" Click="OnConfigShowcasePreviewClick" />
                                                                            <Button x:Name="ConfigShowcaseDeleteButton" Classes="SecondaryActionButton" Margin="0,0,6,6" Content="删除" Click="OnConfigShowcaseDeleteClick" />
                                                                        </WrapPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Classes="ConfigCard">
                                                        <StackPanel Spacing="10">
                                                            <TextBlock x:Name="ConfigWorldRulesTitleTextBlock" Classes="ConfigSectionTitle" Text="世界规则" />
                                                            <ItemsControl x:Name="ConfigWorldRulesItemsControl">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Classes="ConfigInnerCard" Margin="0,0,0,8" IsEnabled="{Binding CanEdit}">
                                                                            <StackPanel Spacing="6">
                                                                                <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" TextWrapping="Wrap" />
                                                                                <CheckBox Classes="ConfigCheck" Content="{Binding BooleanLabel}" IsVisible="{Binding IsBoolean}" IsChecked="{Binding BoolValue, Mode=TwoWay}" />
                                                                                <ComboBox Classes="CompactCombo" Width="360" IsVisible="{Binding IsChoice}" ItemsSource="{Binding ChoiceOptions}" SelectedItem="{Binding SelectedChoiceOption, Mode=TwoWay}">
                                                                                    <ComboBox.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                                                        </DataTemplate>
                                                                                    </ComboBox.ItemTemplate>
                                                                                </ComboBox>
                                                                                <TextBox Classes="CompactInput" IsVisible="{Binding IsText}" Text="{Binding Value, Mode=TwoWay}" />
                                                                                <TextBlock Classes="ConfigHintText" IsVisible="{Binding HasDescription}" Text="{Binding Description}" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Classes="ConfigCard">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock x:Name="ConfigAdvancedJsonTitleTextBlock" Classes="ConfigSectionTitle" Text="高级 JSON" />
                                                            <Button x:Name="ConfigAdvancedJsonButton" HorizontalAlignment="Left" Classes="SecondaryActionButton" Content="编辑高级 JSON" Click="OnConfigAdvancedJsonClick" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </ScrollViewer>

                                            <Border x:Name="ConfigEmptyPanel" Classes="ConfigCard" IsVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <TextBlock x:Name="ConfigNoProfileTextBlock" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" Text="暂无档案，请先创建档案。" />
                                            </Border>
                                        </Grid>
                                    </Grid>

                                    <Grid x:Name="SavesPanel" RowDefinitions="Auto,*" RowSpacing="10" IsVisible="False">
                                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="8">
                                            <ComboBox x:Name="SaveProfileComboBox" Grid.Column="0" Classes="CompactCombo" SelectionChanged="OnSaveProfileSelectionChanged" />
                                            <Button x:Name="ImportSaveButton" Grid.Column="1" Classes="SecondaryActionButton" Content="导入" Click="OnImportSaveClick" />
                                            <Button x:Name="DeleteSaveButton" Grid.Column="2" Classes="SecondaryActionButton" Content="删除" Click="OnDeleteSavesClick" />
                                            <Button x:Name="RefreshSavesButton" Grid.Column="3" Classes="SecondaryActionButton" Content="刷新" Click="OnRefreshSavesClick" />
                                        </Grid>
                                        <ListBox x:Name="SavesListBox" Grid.Row="1" Classes="FlatList" SelectionMode="Multiple">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,8" Padding="12" CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}">
                                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                                            <TextBlock Text="{Binding FileName}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding ProfileName}" FontSize="13" Foreground="{DynamicResource SubTextBrush}" />
                                                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,0" Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>

                                    <Grid x:Name="DownloadVersionsPanel" RowDefinitions="Auto,*,Auto" RowSpacing="10" IsVisible="False">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                            <TextBox x:Name="DownloadVersionSearchTextBox" Grid.Column="0" Classes="CompactInput" PlaceholderText="搜索版本号" TextChanged="OnDownloadVersionSearchTextChanged" />
                                            <Button x:Name="ImportServerPackageButton" Grid.Column="1" Classes="SecondaryActionButton" Content="导入" Click="OnImportServerPackageClick" />
                                            <Button x:Name="RefreshDownloadVersionsButton" Grid.Column="2" Classes="SecondaryActionButton" Content="刷新" Click="OnRefreshDownloadVersionsClick" />
                                        </Grid>
                                        <ListBox x:Name="DownloadVersionsListBox" Grid.Row="1" Classes="FlatList" ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" MinHeight="34" Margin="0,2">
                                                        <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                            <Button Classes="DownloadTextButton" Tag="{Binding}" Content="{Binding ActionText}" IsVisible="{Binding CanDownload}" Click="OnDownloadVersionClick" />
                                                            <TextBlock Classes="DownloadedTextLabel" Text="{Binding DownloadedText}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DownloadedBadgeTextBrush}" IsVisible="{Binding IsDownloaded}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock x:Name="DownloadStatusTextBlock" Grid.Row="2" FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
                                    </Grid>
                                </Grid>
                            </Grid>

                            <Grid x:Name="SettingsPanel" RowDefinitions="Auto,*" RowSpacing="10" IsVisible="False">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button x:Name="ServerSettingsTabButton" Classes="TextTabButton" Content="服务器设置" Click="OnServerSettingsTabClick" />
                                    <Button x:Name="AppearanceSettingsTabButton" Classes="TextTabButton" Content="外观" Click="OnAppearanceSettingsTabClick" />
                                    <Button x:Name="NetworkSettingsTabButton" Classes="TextTabButton" Content="网络" Click="OnNetworkSettingsTabClick" />
                                    <Button x:Name="AdvancedSettingsTabButton" Classes="TextTabButton" Content="高级" Click="OnAdvancedSettingsTabClick" />
                                    <Button x:Name="AboutSettingsTabButton" Classes="TextTabButton" Content="关于" Click="OnAboutSettingsTabClick" />
                                    <Button x:Name="SponsorsSettingsTabButton" Classes="TextTabButton" Content="赞助者" Click="OnSponsorsSettingsTabClick" />
                                    <Button x:Name="ContributorsSettingsTabButton" Classes="TextTabButton" Content="贡献者" Click="OnContributorsSettingsTabClick" />
                                </StackPanel>
                                <Grid Grid.Row="1">
                                    <Grid x:Name="SettingsBlankPanel" />
                                    <Grid x:Name="SettingsAppearancePanel" IsVisible="False" RowDefinitions="Auto,Auto" RowSpacing="12" VerticalAlignment="Top" HorizontalAlignment="Left">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <TextBlock x:Name="SettingsLanguageLabelTextBlock" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource MainTextBrush}" />
                                            <ComboBox x:Name="SettingsLanguageComboBox" Grid.Column="1" Classes="Bordered SettingsGuideCombo" SelectionChanged="OnSettingsLanguageSelectionChanged" />
                                        </Grid>
                                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <TextBlock x:Name="SettingsThemeLabelTextBlock" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource MainTextBrush}" />
                                            <ComboBox x:Name="SettingsThemeComboBox" Grid.Column="1" Classes="Bordered SettingsGuideCombo" SelectionChanged="OnSettingsThemeSelectionChanged" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>

                            <Grid x:Name="RobotPanel" IsVisible="False">
                                <Border Classes="SectionPanel" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="机器人" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="QQ 机器人基础入口已保留，后续接入机器人进程和配置。" FontSize="13" Foreground="{DynamicResource SubTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid x:Name="ConnectionPanel" IsVisible="False">
                                <Border Classes="SectionPanel" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="连接" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="内网穿透与连接监控入口已保留，主页网络图表不会再使用随机数据。" FontSize="13" Foreground="{DynamicResource SubTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>

                    <Border Grid.Row="2" Background="{DynamicResource FooterBackgroundBrush}" BorderBrush="Transparent" BorderThickness="0">
                        <Grid Margin="14,0,14,0" ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="HomeNavButton" Classes="FooterNavButton" Click="OnHomeNavClick" />
                                <Button x:Name="MonitorNavButton" Classes="FooterNavButton" Click="OnMonitorNavClick" />
                                <Button x:Name="ConsoleNavButton" Classes="FooterNavButton" Click="OnConsoleNavClick" />
                                <Button x:Name="InstanceManageNavButton" Classes="FooterNavButton" Click="OnInstanceManageNavClick" />
                                <Button x:Name="RobotNavButton" Classes="FooterNavButton" Click="OnRobotNavClick" />
                                <Button x:Name="ConnectionNavButton" Classes="FooterNavButton" Click="OnConnectionNavClick" />
                                <Button x:Name="SettingsNavButton" Classes="FooterNavButton" Click="OnSettingsNavClick" />
                            </StackPanel>

                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <Button
                                    x:Name="LaunchServerButton"
                                    Click="OnLaunchServerClick"
                                    PointerEntered="OnLaunchServerPointerEntered"
                                    PointerExited="OnLaunchServerPointerExited">
                                    <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="7" VerticalAlignment="Center">
                                        <Path
                                            Width="13"
                                            Height="13"
                                            Stretch="Uniform"
                                            Fill="{DynamicResource LaunchButtonTextBrush}"
                                            Data="M8 5L19 12L8 19Z" />
                                        <TextBlock
                                            x:Name="LaunchActionTextBlock"
                                            Grid.Column="1"
                                            Text="启动服务器"
                                            VerticalAlignment="Center"
                                            FontSize="15"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource LaunchButtonTextBrush}" />
                                        <Border
                                            x:Name="LaunchSelectionPillHost"
                                            Grid.Column="2"
                                            Height="24"
                                            VerticalAlignment="Center">
                                            <Border
                                                Height="24"
                                                MinWidth="122"
                                                MaxWidth="168"
                                                Padding="8,0"
                                                CornerRadius="4"
                                                Background="{DynamicResource LaunchSelectionPillBrush}"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    x:Name="LaunchSelectionSummaryTextBlock"
                                                    Text="未选择档案 | 未固定存档"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Stretch"
                                                    TextAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource LaunchSelectionPillTextBrush}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </Border>
                                    </Grid>
                                </Button>

                                <Popup
                                    x:Name="LaunchSelectionPopup"
                                    PlacementTarget="{Binding #LaunchServerButton}"
                                    Placement="TopEdgeAlignedRight"
                                    VerticalOffset="-8"
                                    IsLightDismissEnabled="True">
                                    <Border
                                        Width="468"
                                        Padding="12"
                                        CornerRadius="8"
                                        BorderBrush="{DynamicResource WindowBorderBrush}"
                                        BorderThickness="1"
                                        Background="{DynamicResource WindowSurfaceBrush}">
                                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                            <TextBlock x:Name="LaunchPickerTitleTextBlock" Text="选择启动目标" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" />
                                            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10">
                                                <Grid RowDefinitions="Auto,*" RowSpacing="6">
                                                    <TextBlock x:Name="LaunchProfileTitleTextBlock" Text="档案" FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
                                                    <ListBox
                                                        x:Name="LaunchProfileListBox"
                                                        Grid.Row="1"
                                                        Classes="LaunchChoiceList"
                                                        SelectionChanged="OnLaunchProfileSelectionChanged">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid RowDefinitions="Auto,Auto">
                                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Row="1" Text="{Binding Version}" FontSize="11" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </Grid>

                                                <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="6">
                                                    <TextBlock x:Name="LaunchSaveTitleTextBlock" Text="存档" FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
                                                    <ListBox
                                                        x:Name="LaunchSaveListBox"
                                                        Grid.Row="1"
                                                        Classes="LaunchChoiceList"
                                                        SelectionChanged="OnLaunchSaveSelectionChanged">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid RowDefinitions="Auto,Auto">
                                                                    <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Row="1" Text="{Binding ProfileName}" FontSize="11" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </Grid>
                                            </Grid>

                                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                <TextBlock x:Name="LaunchPickerHintTextBlock" Text="未选择存档时使用档案默认存档。" FontSize="12" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" />
                                                <Button x:Name="LaunchCancelButton" Grid.Column="1" Classes="SecondaryActionButton" Content="取消" Click="OnLaunchCancelClick" />
                                                <Button x:Name="LaunchConfirmButton" Grid.Column="2" Classes="ActionButton" Content="启动" Click="OnLaunchConfirmClick" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
