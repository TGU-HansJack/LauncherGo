<Window
    x:Class="LauncherGo.Ui.Views.LauncherMainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="980"
    Height="580"
    MinWidth="980"
    MinHeight="580"
    MaxWidth="980"
    MaxHeight="580"
    CanResize="False"
    WindowDecorations="BorderOnly"
    Background="{DynamicResource WindowSurfaceBrush}"
    Icon="avares://LauncherGo.Ui/Assets/app-icon.ico"
    WindowStartupLocation="CenterScreen"
    x:CompileBindings="False"
    Title="LauncherGo">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WindowSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="WindowBorderBrush" Color="#AAB2BC" />
                    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="FooterBackgroundBrush" Color="#F8F9FA" />
                    <SolidColorBrush x:Key="SplitLineBrush" Color="#E8EAED" />
                    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardHoverBrush" Color="#F3F5F7" />
                    <SolidColorBrush x:Key="CardSelectedBrush" Color="#EAF2FF" />
                    <SolidColorBrush x:Key="MainTextBrush" Color="#111111" />
                    <SolidColorBrush x:Key="SubTextBrush" Color="#6A7380" />
                    <SolidColorBrush x:Key="PrimaryLineBrush" Color="#2D6CDF" />
                    <SolidColorBrush x:Key="SecondaryLineBrush" Color="#16A34A" />
                    <SolidColorBrush x:Key="GridLineBrush" Color="#E3E8EE" />
                    <SolidColorBrush x:Key="NavSelectedBrush" Color="#555555" />
                    <SolidColorBrush x:Key="NavSelectedTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="NavNormalTextBrush" Color="#111111" />
                    <SolidColorBrush x:Key="NavDisabledTextBrush" Color="#8A8A8A" />
                    <SolidColorBrush x:Key="LaunchButtonBrush" Color="#6B8E23" />
                    <SolidColorBrush x:Key="LaunchButtonHoverBrush" Color="#789E2C" />
                    <SolidColorBrush x:Key="LaunchButtonPressedBrush" Color="#5D7C1F" />
                    <SolidColorBrush x:Key="LaunchButtonTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="LaunchSelectionPillBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="LaunchSelectionPillTextBrush" Color="#111111" />
                    <SolidColorBrush x:Key="ControlHoverBrush" Color="#ECEFF2" />
                    <SolidColorBrush x:Key="HeaderIconBrush" Color="#000000" />
                    <SolidColorBrush x:Key="HeaderIconHoverBrush" Color="#000000" />
                    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#E5E7EB" />
                    <SolidColorBrush x:Key="ToolTipForegroundBrush" Color="#111111" />
                    <SolidColorBrush x:Key="DropdownHoverBrush" Color="#F1F2F4" />
                    <SolidColorBrush x:Key="DropdownSelectedBrush" Color="#DDEBFF" />
                    <SolidColorBrush x:Key="DropdownSelectedTextBrush" Color="#0F2D62" />
                    <SolidColorBrush x:Key="DownloadActionTextBrush" Color="#111111" />
                    <SolidColorBrush x:Key="DownloadedBadgeTextBrush" Color="#15803D" />
                    <SolidColorBrush x:Key="ConsoleBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ConsoleTextBrush" Color="#000000" />
                    <SolidColorBrush x:Key="ConsoleSelectionBrush" Color="#000000" />
                    <SolidColorBrush x:Key="ConsoleSelectionTextBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WindowSurfaceBrush" Color="#121212" />
                    <SolidColorBrush x:Key="WindowBorderBrush" Color="#3C3C3C" />
                    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#121212" />
                    <SolidColorBrush x:Key="FooterBackgroundBrush" Color="#121212" />
                    <SolidColorBrush x:Key="SplitLineBrush" Color="#3C3C3C" />
                    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#121212" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1B1B1B" />
                    <SolidColorBrush x:Key="CardHoverBrush" Color="#2A2A2A" />
                    <SolidColorBrush x:Key="CardSelectedBrush" Color="#3C3C3C" />
                    <SolidColorBrush x:Key="MainTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SubTextBrush" Color="#BFBFBF" />
                    <SolidColorBrush x:Key="PrimaryLineBrush" Color="#7CB3FF" />
                    <SolidColorBrush x:Key="SecondaryLineBrush" Color="#60D394" />
                    <SolidColorBrush x:Key="GridLineBrush" Color="#334050" />
                    <SolidColorBrush x:Key="NavSelectedBrush" Color="#555555" />
                    <SolidColorBrush x:Key="NavSelectedTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="NavNormalTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="NavDisabledTextBrush" Color="#7A7A7A" />
                    <SolidColorBrush x:Key="LaunchButtonBrush" Color="#6B8E23" />
                    <SolidColorBrush x:Key="LaunchButtonHoverBrush" Color="#789E2C" />
                    <SolidColorBrush x:Key="LaunchButtonPressedBrush" Color="#5D7C1F" />
                    <SolidColorBrush x:Key="LaunchButtonTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="LaunchSelectionPillBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="LaunchSelectionPillTextBrush" Color="#111111" />
                    <SolidColorBrush x:Key="ControlHoverBrush" Color="#3C3C3C" />
                    <SolidColorBrush x:Key="HeaderIconBrush" Color="#F5F5F5" />
                    <SolidColorBrush x:Key="HeaderIconHoverBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToolTipBackgroundBrush" Color="#000000" />
                    <SolidColorBrush x:Key="ToolTipForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DropdownHoverBrush" Color="#1B1B1B" />
                    <SolidColorBrush x:Key="DropdownSelectedBrush" Color="#3C3C3C" />
                    <SolidColorBrush x:Key="DropdownSelectedTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DownloadActionTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DownloadedBadgeTextBrush" Color="#6EE7B7" />
                    <SolidColorBrush x:Key="ConsoleBackgroundBrush" Color="#000000" />
                    <SolidColorBrush x:Key="ConsoleTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ConsoleSelectionBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ConsoleSelectionTextBrush" Color="#000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Path.IconPath">
            <Setter Property="Fill" Value="{DynamicResource HeaderIconBrush}" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>
        <Style Selector="Path.CloseIconPath">
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="{DynamicResource HeaderIconBrush}" />
            <Setter Property="StrokeThickness" Value="1.3" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>
        <Style Selector="TextBlock#HomeSloganTextBlock">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.TitleButton">
            <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource HeaderIconBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.TitleButton /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.TitleButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#30FFFFFF" Offset="0" />
                        <GradientStop Color="#12000000" Offset="0.52" />
                        <GradientStop Color="#18FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#55FFFFFF" Offset="0" />
                        <GradientStop Color="#18000000" Offset="0.55" />
                        <GradientStop Color="#28FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.TitleButton:pressed /template/ ContentPresenter">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="100%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#22000000" Offset="0" />
                        <GradientStop Color="#30FFFFFF" Offset="0.46" />
                        <GradientStop Color="#10000000" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="100%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#44000000" Offset="0" />
                        <GradientStop Color="#55FFFFFF" Offset="0.45" />
                        <GradientStop Color="#26000000" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style Selector="Button.HeaderIconButton">
            <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.HeaderIconButton /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.HeaderIconButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#30FFFFFF" Offset="0" />
                        <GradientStop Color="#12000000" Offset="0.52" />
                        <GradientStop Color="#18FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#55FFFFFF" Offset="0" />
                        <GradientStop Color="#18000000" Offset="0.55" />
                        <GradientStop Color="#28FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.HeaderIconButton:pressed /template/ ContentPresenter">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="100%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#22000000" Offset="0" />
                        <GradientStop Color="#30FFFFFF" Offset="0.46" />
                        <GradientStop Color="#10000000" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="100%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#44000000" Offset="0" />
                        <GradientStop Color="#55FFFFFF" Offset="0.45" />
                        <GradientStop Color="#26000000" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.HeaderIconButton:pointerover Path.IconPath">
            <Setter Property="Fill" Value="{DynamicResource HeaderIconHoverBrush}" />
        </Style>
        <Style Selector="Button.HeaderIconButton:pressed Path.IconPath">
            <Setter Property="Fill" Value="{DynamicResource HeaderIconHoverBrush}" />
        </Style>
        <Style Selector="Button#CloseButton:pointerover Path.CloseIconPath">
            <Setter Property="Stroke" Value="{DynamicResource HeaderIconHoverBrush}" />
        </Style>
        <Style Selector="Button#CloseButton:pressed Path.CloseIconPath">
            <Setter Property="Stroke" Value="{DynamicResource HeaderIconHoverBrush}" />
        </Style>
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="{DynamicResource ToolTipBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ToolTipForegroundBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <Style Selector="Button.FooterNavButton">
            <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource NavNormalTextBrush}" />
        </Style>
        <Style Selector="Button.FooterNavButton /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.FooterNavButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#30FFFFFF" Offset="0" />
                        <GradientStop Color="#12000000" Offset="0.52" />
                        <GradientStop Color="#18FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#55FFFFFF" Offset="0" />
                        <GradientStop Color="#18000000" Offset="0.55" />
                        <GradientStop Color="#28FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.FooterNavButton:pressed /template/ ContentPresenter">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="100%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#22000000" Offset="0" />
                        <GradientStop Color="#30FFFFFF" Offset="0.46" />
                        <GradientStop Color="#10000000" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="100%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#44000000" Offset="0" />
                        <GradientStop Color="#55FFFFFF" Offset="0.45" />
                        <GradientStop Color="#26000000" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.FooterNavButton.selected">
            <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource NavSelectedTextBrush}" />
        </Style>
        <Style Selector="Button.FooterNavButton.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.FooterNavButton.selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}" />
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#55FFFFFF" Offset="0" />
                        <GradientStop Color="#18000000" Offset="0.55" />
                        <GradientStop Color="#28FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.FooterNavButton.selected:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}" />
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="100%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#44000000" Offset="0" />
                        <GradientStop Color="#55FFFFFF" Offset="0.45" />
                        <GradientStop Color="#26000000" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.FooterNavButton:disabled">
            <Setter Property="Foreground" Value="{DynamicResource NavDisabledTextBrush}" />
        </Style>

        <Style Selector="Button.StatusCardButton">
            <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Width" Value="318" />
            <Setter Property="Height" Value="94" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.StatusCardButton /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.StatusCardButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
        </Style>
        <Style Selector="Button.StatusCardButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.StatusCardButton.selected">
            <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.StatusCardButton.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Button#LaunchServerButton">
            <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="146" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="{DynamicResource LaunchButtonBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource LaunchButtonTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CornerRadius" Value="17" />
        </Style>
        <Style Selector="Button#LaunchServerButton /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Background" Value="{DynamicResource LaunchButtonBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button#LaunchServerButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource LaunchButtonBrush}" />
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#55FFFFFF" Offset="0" />
                        <GradientStop Color="#18000000" Offset="0.55" />
                        <GradientStop Color="#28FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button#LaunchServerButton:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource LaunchButtonBrush}" />
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="100%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#44000000" Offset="0" />
                        <GradientStop Color="#55FFFFFF" Offset="0.45" />
                        <GradientStop Color="#26000000" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button#LaunchServerButton.running">
            <Setter Property="Background" Value="#C62828" />
        </Style>
        <Style Selector="Button#LaunchServerButton.running /template/ ContentPresenter">
            <Setter Property="Background" Value="#C62828" />
        </Style>
        <Style Selector="Button#LaunchServerButton.running:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#C62828" />
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#55FFFFFF" Offset="0" />
                        <GradientStop Color="#18000000" Offset="0.55" />
                        <GradientStop Color="#28FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button#LaunchServerButton.running:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#C62828" />
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="100%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#44000000" Offset="0" />
                        <GradientStop Color="#55FFFFFF" Offset="0.45" />
                        <GradientStop Color="#26000000" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Border#LaunchSelectionPillHost">
            <Setter Property="Width" Value="0" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.16" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border#LaunchSelectionPillHost.expanded">
            <Setter Property="Width" Value="168" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="ListBox.LaunchChoiceList">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource SplitLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Height" Value="196" />
        </Style>
        <Style Selector="ListBox.LaunchChoiceList ListBoxItem">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style Selector="Button.ActionButton">
            <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="68" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource NavSelectedTextBrush}" />
        </Style>
        <Style Selector="Button.ActionButton /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}" />
        </Style>
        <Style Selector="Button.SecondaryActionButton">
            <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="68" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}" />
        </Style>
        <Style Selector="Button.SecondaryActionButton /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.TextTabButton">
            <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
            <Setter Property="Padding" Value="10,6,10,6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.TextTabButton /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.TextTabButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.TextTabButton.selected">
            <Setter Property="FontWeight" Value="SemiBold" />
