                                        <Path Classes="IconPath" Data="M311.6 95C297.5 75.5 274.9 64 250.9 64C209.5 64 176 97.5 176 138.9L176 141.3C176 205.7 258 274.7 298.2 304.6C311.2 314.3 328.7 314.3 341.7 304.6C381.9 274.6 463.9 205.7 463.9 141.3L463.9 138.9C463.9 97.5 430.4 64 389 64C365 64 342.4 75.5 328.3 95L320 106.7L311.6 95zM141.3 405.5L98.7 448L64 448C46.3 448 32 462.3 32 480L32 544C32 561.7 46.3 576 64 576L384.5 576C413.5 576 441.8 566.7 465.2 549.5L591.8 456.2C609.6 443.1 613.4 418.1 600.3 400.3C587.2 382.5 562.2 378.7 544.4 391.8L424.6 480L312 480C298.7 480 288 469.3 288 456C288 442.7 298.7 432 312 432L384 432C401.7 432 416 417.7 416 400C416 382.3 401.7 368 384 368L231.8 368C197.9 368 165.3 381.5 141.3 405.5z" />
                                    </Viewbox>
                                </Button>
                                <Button x:Name="CloseButton" Classes="HeaderIconButton" Click="OnCloseClick" ToolTip.Tip="关闭">
                                    <Viewbox Width="14" Height="14">
                                        <Path Classes="CloseIconPath" Data="M18 6L6 18M6 6L18 18" />
                                    </Viewbox>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid x:Name="MainContentHost" Grid.Row="1" Background="{DynamicResource PanelBackgroundBrush}" ClipToBounds="True">
                        <Grid Margin="24,6,24,8">
                            <Grid x:Name="HomePanel" ColumnDefinitions="*,360" ColumnSpacing="30">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="10">
                                    <TextBlock
                                        x:Name="HomeSloganTextBlock"
                                        FontSize="32"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource MainTextBrush}"
                                        TextWrapping="Wrap"
                                        Opacity="1" />
                                </StackPanel>

                                <Grid Grid.Column="1" Width="286" Height="286" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="False">
                                    <Viewbox Width="274" Height="274" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Grid Width="800" Height="800" ClipToBounds="False">
                                            <Canvas Width="800" Height="800" Opacity="0.76">
                                                <Rectangle Width="200" Height="200" Canvas.Left="126" Canvas.Top="259" Fill="#3C000000" RadiusX="12" RadiusY="12" />
                                                <Rectangle Width="200" Height="200" Canvas.Left="526" Canvas.Top="259" Fill="#3C000000" RadiusX="12" RadiusY="12" />
                                                <Rectangle Width="200" Height="200" Canvas.Left="326" Canvas.Top="459" Fill="#3C000000" RadiusX="12" RadiusY="12" />
                                            </Canvas>
                                            <Canvas Width="800" Height="800">
                                                <Rectangle Width="200" Height="200" Canvas.Left="100" Canvas.Top="233" Fill="#6b8e23" RadiusX="12" RadiusY="12" />
                                                <Rectangle Width="200" Height="200" Canvas.Left="500" Canvas.Top="233" Fill="#8b5a2b" RadiusX="12" RadiusY="12" />
                                                <Rectangle Width="200" Height="200" Canvas.Left="300" Canvas.Top="433" Fill="#555555" RadiusX="12" RadiusY="12" />
                                                <Rectangle Width="176" Height="18" Canvas.Left="112" Canvas.Top="245" Fill="#22FFFFFF" RadiusX="8" RadiusY="8" />
                                                <Rectangle Width="176" Height="18" Canvas.Left="512" Canvas.Top="245" Fill="#20FFFFFF" RadiusX="8" RadiusY="8" />
                                                <Rectangle Width="176" Height="18" Canvas.Left="312" Canvas.Top="445" Fill="#1EFFFFFF" RadiusX="8" RadiusY="8" />
                                            </Canvas>
                                            <Canvas Width="800" Height="800" Opacity="0.6">
                                                <Rectangle Width="200" Height="200" Canvas.Left="100" Canvas.Top="233" RadiusX="12" RadiusY="12">
                                                    <Rectangle.Fill>
                                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                            <GradientStop Color="#00FFFFFF" Offset="0" />
                                                            <GradientStop Color="#55FFFFFF" Offset="0.48" />
                                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Rectangle.Fill>
                                                </Rectangle>
                                                <Rectangle Width="200" Height="200" Canvas.Left="500" Canvas.Top="233" RadiusX="12" RadiusY="12">
                                                    <Rectangle.Fill>
                                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                            <GradientStop Color="#00FFFFFF" Offset="0" />
                                                            <GradientStop Color="#4DFFFFFF" Offset="0.48" />
                                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Rectangle.Fill>
                                                </Rectangle>
                                                <Rectangle Width="200" Height="200" Canvas.Left="300" Canvas.Top="433" RadiusX="12" RadiusY="12">
                                                    <Rectangle.Fill>
                                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                            <GradientStop Color="#00FFFFFF" Offset="0" />
                                                            <GradientStop Color="#44FFFFFF" Offset="0.48" />
                                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Rectangle.Fill>
                                                </Rectangle>
                                            </Canvas>
                                        </Grid>
                                    </Viewbox>
                                </Grid>
                            </Grid>
                        </Grid>

                        <Border
                            x:Name="NonHomePanelHost"
                            Background="{DynamicResource WindowSurfaceBrush}"
                            ClipToBounds="True"
                            IsVisible="False"
                            RenderTransform="translate(0px,0px)">
                            <Border.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" />
                                </Transitions>
                            </Border.Transitions>
                            <Grid Margin="24,6,24,8">
                                <Grid Margin="0">

                            <Grid x:Name="MonitorPanel" ColumnDefinitions="330,*" ColumnSpacing="12" IsVisible="False">
                                <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" VerticalAlignment="Top">
                                    <Button x:Name="ServerStatusCard" Grid.Row="0" Classes="StatusCardButton" Click="OnServerStatusCardClick">
                                        <Grid ColumnDefinitions="78,*" ColumnSpacing="12">
                                            <Border Width="76" Height="50" BorderBrush="#111111" BorderThickness="1" Background="Transparent">
                                                <Canvas Width="76" Height="50" Background="Transparent" ClipToBounds="True">
                                                    <Polyline x:Name="ServerStatusThumbLinePrimary" Stroke="{DynamicResource PrimaryLineBrush}" StrokeThickness="1.4" />
                                                    <Polyline x:Name="ServerStatusThumbLineSecondary" Stroke="{DynamicResource SecondaryLineBrush}" StrokeThickness="1.4" />
                                                </Canvas>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock x:Name="ServerStatusCardTitleText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" />
                                                <TextBlock x:Name="ServerStatusCardValueText" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="RobotStatusCard" Grid.Row="1" Classes="StatusCardButton" Click="OnRobotStatusCardClick">
                                        <Grid ColumnDefinitions="78,*" ColumnSpacing="12">
                                            <Border Width="76" Height="50" BorderBrush="#111111" BorderThickness="1" Background="Transparent">
                                                <Canvas Width="76" Height="50" Background="Transparent" ClipToBounds="True">
                                                    <Polyline x:Name="RobotStatusThumbLinePrimary" Stroke="{DynamicResource PrimaryLineBrush}" StrokeThickness="1.4" />
                                                    <Polyline x:Name="RobotStatusThumbLineSecondary" Stroke="{DynamicResource SecondaryLineBrush}" StrokeThickness="1.4" />
                                                </Canvas>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock x:Name="RobotStatusCardTitleText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" />
                                                <TextBlock x:Name="RobotStatusCardValueText" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="OnlinePlayersCard" Grid.Row="2" Classes="StatusCardButton" Click="OnOnlinePlayersCardClick">
                                        <Grid ColumnDefinitions="78,*" ColumnSpacing="12">
                                            <Border Width="76" Height="50" BorderBrush="#111111" BorderThickness="1" Background="Transparent">
                                                <Canvas Width="76" Height="50" Background="Transparent" ClipToBounds="True">
                                                    <Polyline x:Name="OnlinePlayersThumbLinePrimary" Stroke="{DynamicResource PrimaryLineBrush}" StrokeThickness="1.4" />
                                                </Canvas>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock x:Name="OnlinePlayersCardTitleText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" />
                                                <TextBlock x:Name="OnlinePlayersCardValueText" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="NetworkStatusCard" Grid.Row="3" Classes="StatusCardButton" Click="OnNetworkStatusCardClick">
                                        <Grid ColumnDefinitions="78,*" ColumnSpacing="12">
                                            <Border Width="76" Height="50" BorderBrush="#111111" BorderThickness="1" Background="Transparent">
                                                <Canvas Width="76" Height="50" Background="Transparent" ClipToBounds="True">
                                                    <Polyline x:Name="NetworkStatusThumbLinePrimary" Stroke="{DynamicResource PrimaryLineBrush}" StrokeThickness="1.4" />
                                                </Canvas>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock x:Name="NetworkStatusCardTitleText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" />
                                                <TextBlock x:Name="NetworkStatusCardValueText" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </Grid>

                                <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0" Padding="12">
                                    <Grid RowDefinitions="Auto,*,Auto,Auto">
                                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                            <TextBlock x:Name="ChartTitleText" Grid.Row="0" Grid.Column="0" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" />
                                            <TextBlock x:Name="ChartTopValueText" Grid.Row="0" Grid.Column="1" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" VerticalAlignment="Bottom" />
                                            <TextBlock x:Name="ChartSummaryText" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0" FontSize="13" Foreground="{DynamicResource SubTextBrush}" />
                                        </Grid>

                                        <Grid Grid.Row="1" Margin="0,10,0,10" RowDefinitions="*,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                            <Grid Grid.Row="0" Grid.Column="0" Width="50" RowDefinitions="*,*,*,*,*,*" VerticalAlignment="Stretch">
                                                <TextBlock x:Name="YAxisLabelTop" Grid.Row="0" FontSize="11" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                <TextBlock x:Name="YAxisLabel2" Grid.Row="1" FontSize="11" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock x:Name="YAxisLabel3" Grid.Row="2" FontSize="11" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock x:Name="YAxisLabel4" Grid.Row="3" FontSize="11" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock x:Name="YAxisLabel5" Grid.Row="4" FontSize="11" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock x:Name="YAxisLabelBottom" Grid.Row="5" FontSize="11" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                            </Grid>
                                            <Border Grid.Row="0" Grid.Column="1" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0" Padding="8">
                                                <Viewbox Stretch="Fill">
                                                    <Canvas x:Name="ChartCanvas" Width="640" Height="248" Background="Transparent">
                                                        <Line StartPoint="0,0" EndPoint="640,0" Stroke="{DynamicResource GridLineBrush}" StrokeThickness="1" />
                                                        <Line StartPoint="0,50" EndPoint="640,50" Stroke="{DynamicResource GridLineBrush}" StrokeThickness="1" />
                                                        <Line StartPoint="0,100" EndPoint="640,100" Stroke="{DynamicResource GridLineBrush}" StrokeThickness="1" />
                                                        <Line StartPoint="0,150" EndPoint="640,150" Stroke="{DynamicResource GridLineBrush}" StrokeThickness="1" />
                                                        <Line StartPoint="0,200" EndPoint="640,200" Stroke="{DynamicResource GridLineBrush}" StrokeThickness="1" />
                                                        <Line StartPoint="0,248" EndPoint="640,248" Stroke="{DynamicResource GridLineBrush}" StrokeThickness="1" />

                                                        <Polyline x:Name="ChartLinePrimary" Stroke="{DynamicResource PrimaryLineBrush}" StrokeThickness="2" />
                                                        <Polyline x:Name="ChartLineSecondary" Stroke="{DynamicResource SecondaryLineBrush}" StrokeThickness="2" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>
                                            <TextBlock x:Name="ChartXAxisText" Grid.Row="1" Grid.Column="1" Margin="4,6,0,0" FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
                                        </Grid>

                                        <Grid x:Name="ChartDetailGrid" Grid.Row="2" Margin="0,0,0,8" ColumnDefinitions="*,*,*,*" RowDefinitions="Auto" ColumnSpacing="16">
                                            <StackPanel>
                                                <TextBlock x:Name="DetailOneLabelText" FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
                                                <TextBlock x:Name="DetailOneValueText" FontSize="18" Foreground="{DynamicResource MainTextBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock x:Name="DetailTwoLabelText" FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
                                                <TextBlock x:Name="DetailTwoValueText" FontSize="18" Foreground="{DynamicResource MainTextBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock x:Name="DetailThreeLabelText" FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
                                                <TextBlock x:Name="DetailThreeValueText" FontSize="18" Foreground="{DynamicResource MainTextBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3">
                                                <TextBlock x:Name="DetailFourLabelText" FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
                                                <TextBlock x:Name="DetailFourValueText" FontSize="18" Foreground="{DynamicResource MainTextBrush}" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Grid.Row="3" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0" Padding="8" IsVisible="False" x:Name="EventTickerContainer">
                                            <Grid Height="24" ClipToBounds="True">
                                                <TextBlock x:Name="EventTickerCurrentText" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource MainTextBrush}" TextTrimming="CharacterEllipsis" RenderTransform="translate(0px,0px)">
                                                    <TextBlock.Transitions>
                                                        <Transitions>
                                                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" />
                                                        </Transitions>
                                                    </TextBlock.Transitions>
                                                </TextBlock>
                                                <TextBlock x:Name="EventTickerNextText" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource MainTextBrush}" TextTrimming="CharacterEllipsis" RenderTransform="translate(0px,24px)">
                                                    <TextBlock.Transitions>
                                                        <Transitions>
                                                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" />
                                                        </Transitions>
                                                    </TextBlock.Transitions>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid x:Name="ConsolePanel" RowDefinitions="*,Auto" RowSpacing="8" IsVisible="False" Margin="-24,-6,-24,0" ClipToBounds="True">
                                <Border Classes="SectionPanel" Background="{DynamicResource ConsoleBackgroundBrush}" ClipToBounds="True">
                                    <ScrollViewer
                                        x:Name="ConsoleOutputScrollViewer"
                                        Margin="12,0,12,0"
                                        ClipToBounds="True"
                                        HorizontalScrollBarVisibility="Hidden"
                                        VerticalScrollBarVisibility="Hidden">
                                        <SelectableTextBlock
                                            x:Name="ConsoleOutputTextBlock"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            TextWrapping="NoWrap" />
                                    </ScrollViewer>
                                </Border>
                                <Grid Grid.Row="1" Margin="24,0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <TextBox x:Name="CommandTextBox" Classes="CompactInput" PlaceholderText="输入服务器命令，回车发送" KeyDown="OnCommandTextBoxKeyDown" />
                                    <ComboBox
                                        x:Name="QuickCommandComboBox"
                                        Grid.Column="1"
                                        Width="142"
                                        Classes="CompactCombo"
                                        PlaceholderText="快捷命令"
                                        SelectionChanged="OnQuickCommandSelectionChanged" />
                                    <Button x:Name="SendCommandButton" Grid.Column="2" Classes="ActionButton" Content="发送" Click="OnSendCommandClick" />
                                </Grid>
                            </Grid>

                            <Grid x:Name="InstanceManagePanel" RowDefinitions="Auto,*" RowSpacing="10" IsVisible="False">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <Button x:Name="ProfilesTabButton" Classes="TextTabButton" Content="档案列表" Click="OnProfilesSubTabClick" />
                                    <Button x:Name="ConfigTabButton" Classes="TextTabButton" Content="配置" Click="OnConfigSubTabClick" />
                                    <Button x:Name="SavesTabButton" Classes="TextTabButton" Content="存档管理" Click="OnSavesSubTabClick" />
                                    <Button x:Name="AutomationTabButton" Classes="TextTabButton" Content="自动化" Click="OnAutomationSubTabClick" />
                                    <Button x:Name="ModsTabButton" Classes="TextTabButton" Content="模组管理" Click="OnModsSubTabClick" />
                                    <Button x:Name="DownloadVersionsTabButton" Classes="TextTabButton" Content="下载版本" Click="OnDownloadVersionsSubTabClick" />
                                </StackPanel>

                                <Grid Grid.Row="1">
                                    <Grid x:Name="ProfilesPanel" RowDefinitions="Auto,*" RowSpacing="10">
                                        <Grid ColumnDefinitions="Auto,180,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                                            <ComboBox x:Name="CreateVersionComboBox" Grid.Column="0" Classes="CompactCombo" />
                                            <TextBox x:Name="ProfileNameTextBox" Grid.Column="1" Classes="CompactInput" PlaceholderText="档案名称" />
                                            <Button x:Name="CreateProfileButton" Grid.Column="2" Classes="ActionButton" Content="创建" Click="OnCreateProfileClick" />
                                            <Button x:Name="ImportProfileButton" Grid.Column="3" Classes="SecondaryActionButton" Content="导入" Click="OnImportProfileClick" />
                                            <Button x:Name="DeleteProfileButton" Grid.Column="4" Classes="SecondaryActionButton" Content="删除" Click="OnDeleteProfilesClick" />
                                            <Button x:Name="RefreshProfilesButton" Grid.Column="5" Classes="SecondaryActionButton" Content="刷新" Click="OnRefreshProfilesClick" />
                                        </Grid>
                                        <Grid Grid.Row="1" RowDefinitions="Auto,*">
                                            <Border Grid.Row="0" Classes="TableHeader">
                                                <Grid ColumnDefinitions="44,1.1*,.8*,2.5*,2.2*" ColumnSpacing="8">
                                                    <TextBlock Classes="TableHeaderText" Text="选择" HorizontalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Classes="TableHeaderText" Text="档案" />
                                                    <TextBlock Grid.Column="2" Classes="TableHeaderText" Text="版本" />
                                                    <TextBlock Grid.Column="3" Classes="TableHeaderText" Text="档案目录" />
                                                    <TextBlock Grid.Column="4" Classes="TableHeaderText" Text="当前存档" />
                                                </Grid>
                                            </Border>
                                            <Border Grid.Row="1" Classes="TableBody">
                                                <ListBox x:Name="ProfilesListBox" Classes="FlatList TableList" SelectionMode="Multiple">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="44,1.1*,.8*,2.5*,2.2*" ColumnSpacing="8">
                                                                <CheckBox Classes="TableSelectCheck" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}" />
                                                                <TextBlock Grid.Column="1" Classes="TableCellText" Text="{Binding Name}" FontWeight="SemiBold" />
                                                                <TextBlock Grid.Column="2" Classes="TableCellText" Text="{Binding Version}" />
                                                                <TextBlock Grid.Column="3" Classes="TableCellText ProfileSubText" Text="{Binding DirectoryPath}" />
                                                                <TextBlock Grid.Column="4" Classes="TableCellText ProfileSubText" Text="{Binding ActiveSaveFile}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Border>
                                        </Grid>
                                    </Grid>

                                    <Grid x:Name="ConfigPanel" RowDefinitions="Auto,Auto,*" RowSpacing="8" IsVisible="False">
                                        <Grid ColumnDefinitions="232,Auto,Auto,Auto,*" ColumnSpacing="8">
                                            <ComboBox x:Name="ConfigProfileComboBox" Grid.Column="0" Classes="CompactCombo" SelectionChanged="OnConfigProfileSelectionChanged">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button x:Name="ConfigRefreshButton" Grid.Column="1" Classes="SecondaryActionButton" Content="刷新" Click="OnConfigRefreshClick" />
                                            <Button x:Name="ConfigImportButton" Grid.Column="2" Classes="SecondaryActionButton" Content="导入" Click="OnConfigImportClick" />
                                            <Button x:Name="ConfigSaveButton" Grid.Column="3" Classes="ActionButton" Content="保存" Click="OnConfigSaveClick" />
                                        </Grid>

                                        <TextBlock x:Name="ConfigStatusTextBlock" Grid.Row="1" FontSize="12" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" />

                                        <Grid Grid.Row="2">
                                            <ScrollViewer x:Name="ConfigScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                                <StackPanel x:Name="ConfigContentHost" Spacing="10">
                                                    <Border Classes="ConfigCard">
                                                        <StackPanel Spacing="10">
                                                            <TextBlock x:Name="ConfigBasicInfoTitleTextBlock" Classes="ConfigSectionTitle" Text="基础信息" />
                                                            <WrapPanel Orientation="Horizontal">
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigServerNameLabelTextBlock" Classes="ConfigFieldLabel" Text="服务器名称" />
                                                                    <TextBox x:Name="ConfigServerNameTextBox" Classes="CompactInput" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigServerLanguageLabelTextBlock" Classes="ConfigFieldLabel" Text="服务器语言" />
                                                                    <ComboBox x:Name="ConfigServerLanguageComboBox" Classes="CompactCombo" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigDefaultRoleCodeLabelTextBlock" Classes="ConfigFieldLabel" Text="默认角色代码" />
                                                                    <ComboBox x:Name="ConfigDefaultRoleComboBox" Classes="CompactCombo" SelectionChanged="OnConfigDefaultRoleSelectionChanged">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                    <TextBox x:Name="ConfigDefaultRoleCodeTextBox" Classes="CompactInput" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormFieldWide">
                                                                    <TextBlock x:Name="ConfigServerDescriptionLabelTextBlock" Classes="ConfigFieldLabel" Text="服务器描述" />
                                                                    <TextBox x:Name="ConfigServerDescriptionTextBox" Classes="MultiLineInput" Height="64" AcceptsReturn="True" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormFieldWide">
                                                                    <TextBlock x:Name="ConfigWelcomeMessageLabelTextBlock" Classes="ConfigFieldLabel" Text="进服提示" />
                                                                    <TextBox x:Name="ConfigWelcomeMessageTextBox" Classes="CompactInput" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Classes="ConfigCard">
                                                        <StackPanel Spacing="10">
                                                            <TextBlock x:Name="ConfigNetworkTitleTextBlock" Classes="ConfigSectionTitle" Text="网络与公开" />
                                                            <WrapPanel Orientation="Horizontal">
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigIpLabelTextBlock" Classes="ConfigFieldLabel" Text="IP" />
                                                                    <TextBox x:Name="ConfigIpTextBox" Classes="CompactInput" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigPortLabelTextBlock" Classes="ConfigFieldLabel" Text="端口" />
                                                                    <NumericUpDown x:Name="ConfigPortNumericUpDown" Classes="CompactNumber" Minimum="1" Maximum="65535" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigMaxClientsLabelTextBlock" Classes="ConfigFieldLabel" Text="最大玩家数" />
                                                                    <NumericUpDown x:Name="ConfigMaxClientsNumericUpDown" Classes="CompactNumber" Minimum="1" Maximum="200" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigMaxClientsInQueueLabelTextBlock" Classes="ConfigFieldLabel" Text="排队人数上限" />
                                                                    <NumericUpDown x:Name="ConfigMaxClientsInQueueNumericUpDown" Classes="CompactNumber" Minimum="0" Maximum="200" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormFieldWide">
                                                                    <TextBlock x:Name="ConfigServerUrlLabelTextBlock" Classes="ConfigFieldLabel" Text="服务器网址" />
                                                                    <TextBox x:Name="ConfigServerUrlTextBox" Classes="CompactInput" />
                                                                </StackPanel>
                                                                <ToggleSwitch x:Name="ConfigAdvertiseServerCheckBox" Classes="ConfigCheck" />
                                                                <ToggleSwitch x:Name="ConfigUpnpCheckBox" Classes="ConfigCheck" />
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Classes="ConfigCard">
                                                        <StackPanel Spacing="10">
                                                            <TextBlock x:Name="ConfigSecurityTitleTextBlock" Classes="ConfigSectionTitle" Text="安全与维护" />
                                                            <WrapPanel Orientation="Horizontal">
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigPasswordLabelTextBlock" Classes="ConfigFieldLabel" Text="加入密码" />
                                                                    <TextBox x:Name="ConfigPasswordTextBox" Classes="CompactInput" PasswordChar="*" />
                                                                    <TextBlock x:Name="ConfigPasswordHintTextBlock" Classes="ConfigHintText" Text="留空表示不设置密码。" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigWhitelistModeLabelTextBlock" Classes="ConfigFieldLabel" Text="白名单模式" />
                                                                    <ComboBox x:Name="ConfigWhitelistModeComboBox" Classes="CompactCombo">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigWarnAfkSecondsLabelTextBlock" Classes="ConfigFieldLabel" Text="AFK 警告秒数" />
                                                                    <NumericUpDown x:Name="ConfigWarnAfkSecondsNumericUpDown" Classes="CompactNumber" Minimum="0" Maximum="86400" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigKickAfkSecondsLabelTextBlock" Classes="ConfigFieldLabel" Text="AFK 踢出秒数" />
                                                                    <NumericUpDown x:Name="ConfigKickAfkSecondsNumericUpDown" Classes="CompactNumber" Minimum="0" Maximum="86400" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigClientConnectionTimeoutLabelTextBlock" Classes="ConfigFieldLabel" Text="连接超时秒数" />
                                                                    <NumericUpDown x:Name="ConfigClientConnectionTimeoutNumericUpDown" Classes="CompactNumber" Minimum="1" Maximum="3600" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigMaxChunkRadiusLabelTextBlock" Classes="ConfigFieldLabel" Text="最大区块视距半径" />
                                                                    <NumericUpDown x:Name="ConfigMaxChunkRadiusNumericUpDown" Classes="CompactNumber" Minimum="1" Maximum="64" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigDieBelowDiskSpaceMbLabelTextBlock" Classes="ConfigFieldLabel" Text="低于磁盘空间时关闭（MB）" />
                                                                    <NumericUpDown x:Name="ConfigDieBelowDiskSpaceMbNumericUpDown" Classes="CompactNumber" Minimum="-1" Maximum="1048576" />
                                                                </StackPanel>
                                                                <ToggleSwitch x:Name="ConfigVerifyPlayerAuthCheckBox" Classes="ConfigCheck" />
                                                                <ToggleSwitch x:Name="ConfigAllowPvPCheckBox" Classes="ConfigCheck" />
                                                                <ToggleSwitch x:Name="ConfigAllowFireSpreadCheckBox" Classes="ConfigCheck" />
                                                                <ToggleSwitch x:Name="ConfigAllowFallingBlocksCheckBox" Classes="ConfigCheck" />
                                                                <ToggleSwitch x:Name="ConfigPassTimeWhenEmptyCheckBox" Classes="ConfigCheck" />
                                                                <ToggleSwitch x:Name="ConfigCorruptionProtectionCheckBox" Classes="ConfigCheck" />
                                                                <ToggleSwitch x:Name="ConfigRegenerateCorruptChunksCheckBox" Classes="ConfigCheck" />
                                                                <StackPanel Classes="ConfigFormFieldWide">
                                                                    <TextBlock x:Name="ConfigStartupCommandsLabelTextBlock" Classes="ConfigFieldLabel" Text="启动后执行命令" />
                                                                    <TextBox x:Name="ConfigStartupCommandsTextBox" Classes="MultiLineInput" Height="74" AcceptsReturn="True" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Classes="ConfigCard">
                                                        <StackPanel Spacing="10">
                                                            <TextBlock x:Name="ConfigWorldTitleTextBlock" Classes="ConfigSectionTitle" Text="世界" />
                                                            <WrapPanel Orientation="Horizontal">
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigSeedLabelTextBlock" Classes="ConfigFieldLabel" Text="种子" />
                                                                    <TextBox x:Name="ConfigSeedTextBox" Classes="CompactInput" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigWorldNameLabelTextBlock" Classes="ConfigFieldLabel" Text="世界名称" />
                                                                    <TextBox x:Name="ConfigWorldNameTextBox" Classes="CompactInput" />
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigSaveFileLabelTextBlock" Classes="ConfigFieldLabel" Text="存档文件" />
                                                                    <ComboBox x:Name="ConfigSaveFileComboBox" Classes="CompactCombo" SelectionChanged="OnConfigSaveFileSelectionChanged">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigPlayStyleLabelTextBlock" Classes="ConfigFieldLabel" Text="游玩风格" />
                                                                    <ComboBox x:Name="ConfigPlayStyleComboBox" Classes="CompactCombo">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigWorldTypeLabelTextBlock" Classes="ConfigFieldLabel" Text="世界类型" />
                                                                    <ComboBox x:Name="ConfigWorldTypeComboBox" Classes="CompactCombo">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                </StackPanel>
                                                                <StackPanel Classes="ConfigFormField">
                                                                    <TextBlock x:Name="ConfigWorldHeightLabelTextBlock" Classes="ConfigFieldLabel" Text="世界高度" />
                                                                    <NumericUpDown x:Name="ConfigWorldHeightNumericUpDown" Classes="CompactNumber" Minimum="64" Maximum="2048" />
                                                                </StackPanel>
                                                            </WrapPanel>
                                                            <TextBlock x:Name="ConfigWorldGeneratedNoticeTextBlock" Classes="ConfigHintText" IsVisible="False" Text="当前存档已生成世界：建档阶段配置已锁定。" />
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Classes="ConfigCard">
                                                        <StackPanel Spacing="10">
                                                            <TextBlock x:Name="ConfigWorldRulesTitleTextBlock" Classes="ConfigSectionTitle" Text="世界规则" />
                                                            <ItemsControl x:Name="ConfigWorldRulesItemsControl">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel Orientation="Horizontal" ItemWidth="270" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Classes="ConfigInnerCard" Width="270" Margin="0,0,10,10" IsEnabled="{Binding CanEdit}">
                                                                            <StackPanel Spacing="6">
                                                                                <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" TextWrapping="Wrap" />
                                                                                <ToggleSwitch Classes="ConfigCheck" IsVisible="{Binding IsBoolean}" IsChecked="{Binding BoolValue, Mode=TwoWay}" />
                                                                                <ComboBox Classes="CompactCombo" IsVisible="{Binding IsChoice}" ItemsSource="{Binding ChoiceOptions}" SelectedItem="{Binding SelectedChoiceOption, Mode=TwoWay}">
                                                                                    <ComboBox.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                                                        </DataTemplate>
                                                                                    </ComboBox.ItemTemplate>
                                                                                </ComboBox>
                                                                                <TextBox Classes="CompactInput" IsVisible="{Binding IsText}" Text="{Binding Value, Mode=TwoWay}" />
                                                                                <TextBlock Classes="ConfigHintText" IsVisible="{Binding HasDescription}" Text="{Binding Description}" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>

                                                </StackPanel>
                                            </ScrollViewer>

                                            <Border x:Name="ConfigEmptyPanel" Classes="ConfigCard" IsVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <TextBlock x:Name="ConfigNoProfileTextBlock" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" Text="暂无档案，请先创建档案。" />
                                            </Border>
                                        </Grid>
                                    </Grid>

                                    <Grid x:Name="SavesPanel" RowDefinitions="Auto,Auto,*" RowSpacing="10" IsVisible="False">
                                        <Grid ColumnDefinitions="Auto,170,Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="8">
                                            <ComboBox x:Name="SaveProfileComboBox" Grid.Column="0" Classes="CompactCombo" SelectionChanged="OnSaveProfileSelectionChanged" />
                                            <TextBox x:Name="NewSaveNameTextBox" Grid.Column="1" Classes="CompactInput" PlaceholderText="新存档名称" />
                                            <Button x:Name="CreateSaveButton" Grid.Column="2" Classes="SecondaryActionButton" Content="创建存档" Click="OnCreateSaveClick" />
                                            <Button x:Name="BackupSaveButton" Grid.Column="3" Classes="SecondaryActionButton" Content="备份当前" Click="OnBackupActiveSaveClick" />
                                            <Button x:Name="InspectSavePathButton" Grid.Column="4" Classes="SecondaryActionButton" Content="检查路径" Click="OnInspectSavePathClick" />
                                            <Button x:Name="ImportSaveButton" Grid.Column="5" Classes="SecondaryActionButton" Content="导入" Click="OnImportSaveClick" />
                                            <Button x:Name="DeleteSaveButton" Grid.Column="6" Classes="SecondaryActionButton" Content="删除" Click="OnDeleteSavesClick" />
                                            <Button x:Name="RefreshSavesButton" Grid.Column="7" Classes="SecondaryActionButton" Content="刷新" Click="OnRefreshSavesClick" />
                                        </Grid>
                                        <TextBlock x:Name="SavePathInspectionTextBlock" Grid.Row="1" Classes="ConfigHintText" TextWrapping="Wrap" PointerPressed="OnOpenInspectedSaveFolderClick" />
                                        <Grid Grid.Row="2" RowDefinitions="Auto,*">
                                            <Border Grid.Row="0" Classes="TableHeader">
                                                <Grid ColumnDefinitions="44,1.4*,1.1*,.8*,1.2*,2.2*,58,Auto" ColumnSpacing="8">
                                                    <TextBlock Classes="TableHeaderText" Text="选择" HorizontalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Classes="TableHeaderText" Text="存档" />
                                                    <TextBlock Grid.Column="2" Classes="TableHeaderText" Text="档案" />
                                                    <TextBlock Grid.Column="3" Classes="TableHeaderText" Text="大小" />
                                                    <TextBlock Grid.Column="4" Classes="TableHeaderText" Text="修改时间" />
                                                    <TextBlock Grid.Column="5" Classes="TableHeaderText" Text="路径" />
                                                    <TextBlock Grid.Column="6" Classes="TableHeaderText" Text="当前" HorizontalAlignment="Center" />
                                                    <TextBlock Grid.Column="7" Classes="TableHeaderText" Text="操作" HorizontalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <Border Grid.Row="1" Classes="TableBody">
                                                <ListBox x:Name="SavesListBox" Classes="FlatList TableList" SelectionMode="Multiple">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="44,1.4*,1.1*,.8*,1.2*,2.2*,58,Auto" ColumnSpacing="8" MinHeight="36">
                                                                <CheckBox Classes="TableSelectCheck" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}" />
                                                                <TextBlock Grid.Column="1" Classes="TableCellText" Text="{Binding FileName}" FontWeight="SemiBold" />
                                                                <TextBlock Grid.Column="2" Classes="TableCellText" Text="{Binding ProfileName}" />
                                                                <TextBlock Grid.Column="3" Classes="TableCellText" Text="{Binding SizeText}" />
                                                                <TextBlock Grid.Column="4" Classes="TableCellText" Text="{Binding LastWriteText}" />
                                                                <TextBlock Grid.Column="5" Classes="TableCellText" Text="{Binding DirectoryPath}" />
                                                                <CheckBox Grid.Column="6" Classes="TableSelectCheck" IsChecked="{Binding IsLocked}" IsEnabled="False" />
                                                                <Button Grid.Column="7" Classes="SaveLockButton" Tag="{Binding}" Click="OnToggleDefaultSaveClick">
                                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                        <Path Width="14" Height="14" Stretch="Uniform" Fill="{Binding LockIconBrush}" Data="{Binding LockIconData}" />
                                                                        <TextBlock Text="{Binding LockActionText}" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DownloadActionTextBrush}" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Border>
                                        </Grid>
                                    </Grid>

                                    <Grid x:Name="AutomationPanel" RowDefinitions="Auto,Auto,*" RowSpacing="8" IsVisible="False">
                                        <Grid ColumnDefinitions="212,Auto,Auto,Auto,*" ColumnSpacing="8">
                                            <ComboBox x:Name="AutomationProfileComboBox" Grid.Column="0" Classes="CompactCombo" SelectionChanged="OnAutomationProfileSelectionChanged">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button x:Name="AutomationSaveButton" Grid.Column="1" Classes="ActionButton" Content="保存" Click="OnAutomationSaveClick" />
                                            <Button x:Name="AutomationRefreshButton" Grid.Column="2" Classes="SecondaryActionButton" Content="刷新" Click="OnAutomationRefreshClick" />
                                            <Button x:Name="AutomationSyncLogsButton" Grid.Column="3" Classes="SecondaryActionButton" Content="同步日志" Click="OnAutomationSyncLogsClick" />
                                        </Grid>
                                        <TextBlock x:Name="AutomationStatusTextBlock" Grid.Row="1" Classes="ConfigHintText" TextWrapping="Wrap" />
                                        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                            <StackPanel Spacing="10">
                                                <Border Classes="ConfigCard">
                                                    <StackPanel Spacing="8">
                                                        <WrapPanel Orientation="Horizontal">
                                                            <ToggleSwitch x:Name="AutomationRestartEnabledCheckBox" Classes="ConfigCheck" />
                                                            <ToggleSwitch x:Name="AutomationBackupEnabledCheckBox" Classes="ConfigCheck" />
                                                            <ToggleSwitch x:Name="AutomationBackupBeforeShutdownCheckBox" Classes="ConfigCheck" />
                                                            <ToggleSwitch x:Name="AutomationBroadcastEnabledCheckBox" Classes="ConfigCheck" />
                                                            <ToggleSwitch x:Name="AutomationExportEnabledCheckBox" Classes="ConfigCheck" />
                                                            <ToggleSwitch x:Name="AutomationExportBeforeShutdownCheckBox" Classes="ConfigCheck" />
                                                            <ToggleSwitch x:Name="AutomationExportIncludeChatCheckBox" Classes="ConfigCheck" />
                                                            <ToggleSwitch x:Name="AutomationExportIncludeServerCheckBox" Classes="ConfigCheck" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>

                                                <Border Classes="ConfigCard">
                                                    <StackPanel Spacing="8">
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                            <TextBlock x:Name="AutomationActionTitleTextBlock" Classes="ConfigSectionTitle" Text="定时开关服" />
                                                            <Button x:Name="AutomationAddActionButton" Grid.Column="1" Classes="SecondaryActionButton" HorizontalAlignment="Right" Content="添加" Click="OnAutomationAddActionClick" />
                                                        </Grid>
                                                        <Border Classes="TableHeader">
                                                            <Grid ColumnDefinitions="50,110,70,70,95,95,70,70,92,Auto" ColumnSpacing="8">
                                                                <TextBlock Classes="TableHeaderText" Text="启用" HorizontalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Classes="TableHeaderText" Text="模式" />
                                                                <TextBlock Grid.Column="2" Classes="TableHeaderText" Text="开始周" />
                                                                <TextBlock Grid.Column="3" Classes="TableHeaderText" Text="结束周" />
                                                                <TextBlock Grid.Column="4" Classes="TableHeaderText" Text="开始日期" />
                                                                <TextBlock Grid.Column="5" Classes="TableHeaderText" Text="结束日期" />
                                                                <TextBlock Grid.Column="6" Classes="TableHeaderText" Text="开始" />
                                                                <TextBlock Grid.Column="7" Classes="TableHeaderText" Text="结束" />
                                                                <TextBlock Grid.Column="8" Classes="TableHeaderText" Text="动作" />
                                                                <TextBlock Grid.Column="9" Classes="TableHeaderText" Text="操作" HorizontalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                        <Border Classes="TableBody">
                                                            <ItemsControl x:Name="AutomationActionsItemsControl">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Classes="TableRow">
                                                                            <Grid ColumnDefinitions="50,110,70,70,95,95,70,70,92,Auto" ColumnSpacing="8">
                                                                                <ToggleSwitch Classes="TableSwitch" IsChecked="{Binding Enabled, Mode=TwoWay}" />
                                                                                <ComboBox Grid.Column="1" Classes="CompactCombo" ItemsSource="{Binding ScheduleModeOptions}" SelectedItem="{Binding SelectedScheduleMode, Mode=TwoWay}" />
                                                                                <TextBox Grid.Column="2" Classes="CompactInput" Text="{Binding StartDayOfWeek, Mode=TwoWay}" />
                                                                                <TextBox Grid.Column="3" Classes="CompactInput" Text="{Binding EndDayOfWeek, Mode=TwoWay}" />
                                                                                <TextBox Grid.Column="4" Classes="CompactInput" PlaceholderText="yyyy-MM-dd" Text="{Binding StartDate, Mode=TwoWay}" />
                                                                                <TextBox Grid.Column="5" Classes="CompactInput" PlaceholderText="yyyy-MM-dd" Text="{Binding EndDate, Mode=TwoWay}" />
                                                                                <TextBox Grid.Column="6" Classes="CompactInput" PlaceholderText="08:00" Text="{Binding StartTime, Mode=TwoWay}" />
                                                                                <TextBox Grid.Column="7" Classes="CompactInput" PlaceholderText="23:00" Text="{Binding EndTime, Mode=TwoWay}" />
                                                                                <ComboBox Grid.Column="8" Classes="CompactCombo" ItemsSource="{Binding ActionOptions}" SelectedItem="{Binding SelectedAction, Mode=TwoWay}" />
                                                                                <Button Grid.Column="9" Classes="SecondaryActionButton" Tag="{Binding}" Content="删除" Click="OnAutomationRemoveActionClick" />
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>

                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                    <Border Classes="ConfigCard">
                                                        <StackPanel Spacing="8">
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                                <TextBlock Classes="ConfigSectionTitle" Text="定时备份" />
                                                                <Button x:Name="AutomationAddBackupTimeButton" Grid.Column="1" Classes="SecondaryActionButton" HorizontalAlignment="Right" Content="添加" Click="OnAutomationAddBackupTimeClick" />
                                                            </Grid>
                                                            <Border Classes="TableHeader">
                                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                    <TextBlock Classes="TableHeaderText" Text="时间" />
                                                                    <TextBlock Grid.Column="1" Classes="TableHeaderText" Text="操作" HorizontalAlignment="Center" />
                                                                </Grid>
                                                            </Border>
                                                            <Border Classes="TableBody">
                                                                <ItemsControl x:Name="AutomationBackupTimesItemsControl">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Classes="TableRow">
                                                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                                    <TextBox Classes="CompactInput" PlaceholderText="03:00" Text="{Binding Time, Mode=TwoWay}" />
                                                                                    <Button Grid.Column="1" Classes="SecondaryActionButton" Tag="{Binding}" Content="删除" Click="OnAutomationRemoveBackupTimeClick" />
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="1" Classes="ConfigCard">
                                                        <StackPanel Spacing="8">
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                                <TextBlock Classes="ConfigSectionTitle" Text="日志导出" />
                                                                <Button x:Name="AutomationAddExportTimeButton" Grid.Column="1" Classes="SecondaryActionButton" HorizontalAlignment="Right" Content="添加" Click="OnAutomationAddExportTimeClick" />
                                                            </Grid>
                                                            <Border Classes="TableHeader">
                                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                    <TextBlock Classes="TableHeaderText" Text="时间" />
                                                                    <TextBlock Grid.Column="1" Classes="TableHeaderText" Text="操作" HorizontalAlignment="Center" />
                                                                </Grid>
                                                            </Border>
                                                            <Border Classes="TableBody">
                                                                <ItemsControl x:Name="AutomationExportTimesItemsControl">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Classes="TableRow">
                                                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                                    <TextBox Classes="CompactInput" PlaceholderText="12:00" Text="{Binding Time, Mode=TwoWay}" />
                                                                                    <Button Grid.Column="1" Classes="SecondaryActionButton" Tag="{Binding}" Content="删除" Click="OnAutomationRemoveExportTimeClick" />
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>

                                                <Border Classes="ConfigCard">
                                                    <StackPanel Spacing="8">
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                            <TextBlock Classes="ConfigSectionTitle" Text="定时广播" />
                                                            <Button x:Name="AutomationAddBroadcastButton" Grid.Column="1" Classes="SecondaryActionButton" HorizontalAlignment="Right" Content="添加" Click="OnAutomationAddBroadcastClick" />
                                                        </Grid>
                                                        <Border Classes="TableHeader">
                                                            <Grid ColumnDefinitions="50,90,*,Auto" ColumnSpacing="8">
                                                                <TextBlock Classes="TableHeaderText" Text="启用" HorizontalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Classes="TableHeaderText" Text="时间" />
                                                                <TextBlock Grid.Column="2" Classes="TableHeaderText" Text="消息" />
                                                                <TextBlock Grid.Column="3" Classes="TableHeaderText" Text="操作" HorizontalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                        <Border Classes="TableBody">
                                                            <ItemsControl x:Name="AutomationBroadcastsItemsControl">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Classes="TableRow">
                                                                            <Grid ColumnDefinitions="50,90,*,Auto" ColumnSpacing="8">
                                                                                <ToggleSwitch Classes="TableSwitch" IsChecked="{Binding Enabled, Mode=TwoWay}" />
                                                                                <TextBox Grid.Column="1" Classes="CompactInput" PlaceholderText="12:00" Text="{Binding Time, Mode=TwoWay}" />
                                                                                <TextBox Grid.Column="2" Classes="CompactInput" Text="{Binding Message, Mode=TwoWay}" />
                                                                                <Button Grid.Column="3" Classes="SecondaryActionButton" Tag="{Binding}" Content="删除" Click="OnAutomationRemoveBroadcastClick" />
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>

                                                <Border Classes="ConfigCard">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock Classes="ConfigSectionTitle" Text="运行日志" />
                                                        <ListBox x:Name="AutomationRuntimeLogsListBox" Classes="FlatList" Height="160" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>

                                    <Grid x:Name="ModsPanel" RowDefinitions="Auto,Auto,*" RowSpacing="8" IsVisible="False">
                                        <Grid ColumnDefinitions="192,*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                                            <ComboBox x:Name="ModProfileComboBox" Grid.Column="0" Classes="CompactCombo" SelectionChanged="OnModProfileSelectionChanged">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBox x:Name="ModZipPathTextBox" Grid.Column="1" Classes="CompactInput" PlaceholderText="Mod ZIP 路径" />
                                            <Button x:Name="BrowseModZipButton" Grid.Column="2" Classes="SecondaryActionButton" Content="浏览" Click="OnBrowseModZipClick" />
                                            <Button x:Name="ImportModZipButton" Grid.Column="3" Classes="SecondaryActionButton" Content="导入" Click="OnImportModZipClick" />
                                            <Button x:Name="DeleteSelectedModsButton" Grid.Column="4" Classes="SecondaryActionButton" Content="删除" Click="OnDeleteSelectedModsClick" />
                                            <Button x:Name="RefreshModsButton" Grid.Column="5" Classes="SecondaryActionButton" Content="刷新" Click="OnRefreshModsClick" />
                                        </Grid>
                                        <TextBlock x:Name="ModStatusTextBlock" Grid.Row="1" Classes="ConfigHintText" TextWrapping="Wrap" />
                                        <Grid Grid.Row="2" RowDefinitions="Auto,*">
                                            <Border Grid.Row="0" Classes="TableHeader">
                                                <Grid ColumnDefinitions="44,1.2*,.7*,58,1*,1.2*,1.2*,2.1*" ColumnSpacing="8">
                                                    <TextBlock Classes="TableHeaderText" Text="选择" HorizontalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Classes="TableHeaderText" Text="Mod ID" />
                                                    <TextBlock Grid.Column="2" Classes="TableHeaderText" Text="版本" />
                                                    <TextBlock Grid.Column="3" Classes="TableHeaderText" Text="启用" HorizontalAlignment="Center" />
                                                    <TextBlock Grid.Column="4" Classes="TableHeaderText" Text="状态" />
                                                    <TextBlock Grid.Column="5" Classes="TableHeaderText" Text="依赖" />
                                                    <TextBlock Grid.Column="6" Classes="TableHeaderText" Text="问题" />
                                                    <TextBlock Grid.Column="7" Classes="TableHeaderText" Text="文件" />
                                                </Grid>
                                            </Border>
                                            <Border Grid.Row="1" Classes="TableBody">
                                                <ListBox x:Name="ModsListBox" Classes="FlatList TableList" SelectionMode="Multiple">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="44,1.2*,.7*,58,1*,1.2*,1.2*,2.1*" ColumnSpacing="8" MinHeight="36">
                                                                <CheckBox Classes="TableSelectCheck" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}" />
                                                                <TextBlock Grid.Column="1" Classes="TableCellText" Text="{Binding ModId}" FontWeight="SemiBold" />
                                                                <TextBlock Grid.Column="2" Classes="TableCellText" Text="{Binding Version}" />
                                                                <ToggleSwitch Grid.Column="3" Classes="TableSwitch" IsChecked="{Binding ModEnabled}" Tag="{Binding}" Click="OnModEnabledSwitchClick" />
                                                                <TextBlock Grid.Column="4" Classes="TableCellText" Text="{Binding StatusText}" />
                                                                <TextBlock Grid.Column="5" Classes="TableCellText" Text="{Binding DependenciesText}" />
                                                                <TextBlock Grid.Column="6" Classes="TableCellText" Text="{Binding IssuesText}" />
                                                                <TextBlock Grid.Column="7" Classes="TableCellText" Text="{Binding FilePath}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Border>
                                        </Grid>
                                    </Grid>

                                    <Grid x:Name="DownloadVersionsPanel" RowDefinitions="Auto,*,Auto" RowSpacing="10" IsVisible="False">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                            <TextBox x:Name="DownloadVersionSearchTextBox" Grid.Column="0" Classes="CompactInput" PlaceholderText="搜索版本号" TextChanged="OnDownloadVersionSearchTextChanged" />
                                            <Button x:Name="ImportServerPackageButton" Grid.Column="1" Classes="SecondaryActionButton" Content="导入" Click="OnImportServerPackageClick" />
                                            <Button x:Name="RefreshDownloadVersionsButton" Grid.Column="2" Classes="SecondaryActionButton" Content="刷新" Click="OnRefreshDownloadVersionsClick" />
                                        </Grid>
                                        <Grid Grid.Row="1" RowDefinitions="Auto,*">
                                            <Border Grid.Row="0" Classes="TableHeader">
                                                <Grid ColumnDefinitions="1.1*,1*,.8*,2.4*,Auto" ColumnSpacing="8">
                                                    <TextBlock Classes="TableHeaderText" Text="版本" />
                                                    <TextBlock Grid.Column="1" Classes="TableHeaderText" Text="平台" />
                                                    <TextBlock Grid.Column="2" Classes="TableHeaderText" Text="大小" />
                                                    <TextBlock Grid.Column="3" Classes="TableHeaderText" Text="文件" />
                                                    <TextBlock Grid.Column="4" Classes="TableHeaderText" Text="操作" HorizontalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <Border Grid.Row="1" Classes="TableBody">
                                                <ListBox x:Name="DownloadVersionsListBox" Classes="FlatList TableList" ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="1.1*,1*,.8*,2.4*,Auto" ColumnSpacing="8" MinHeight="36">
                                                                <TextBlock Classes="TableCellText" Text="{Binding Entry.Version}" FontWeight="SemiBold" />
                                                                <TextBlock Grid.Column="1" Classes="TableCellText" Text="{Binding Entry.Platform}" />
                                                                <TextBlock Grid.Column="2" Classes="TableCellText" Text="{Binding Entry.FileSize}" />
                                                                <TextBlock Grid.Column="3" Classes="TableCellText" Text="{Binding Entry.FileName}" />
                                                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                                    <Button Classes="DownloadTextButton" Tag="{Binding}" Content="{Binding ActionText}" IsVisible="{Binding CanDownload}" Click="OnDownloadVersionClick" />
                                                                    <TextBlock Classes="DownloadedTextLabel" Text="{Binding DownloadedText}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource DownloadedBadgeTextBrush}" IsVisible="{Binding IsDownloaded}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Border>
                                        </Grid>
                                        <TextBlock x:Name="DownloadStatusTextBlock" Grid.Row="2" FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
                                    </Grid>
                                </Grid>
                            </Grid>

                            <Grid x:Name="SettingsPanel" RowDefinitions="Auto,*" RowSpacing="10" IsVisible="False">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button x:Name="ServerSettingsTabButton" Classes="TextTabButton" Content="服务器设置" Click="OnServerSettingsTabClick" />
                                    <Button x:Name="AppearanceSettingsTabButton" Classes="TextTabButton" Content="外观" Click="OnAppearanceSettingsTabClick" />
                                    <Button x:Name="NetworkSettingsTabButton" Classes="TextTabButton" Content="网络" Click="OnNetworkSettingsTabClick" />
                                    <Button x:Name="AdvancedSettingsTabButton" Classes="TextTabButton" Content="高级" Click="OnAdvancedSettingsTabClick" />
                                    <Button x:Name="AboutSettingsTabButton" Classes="TextTabButton" Content="关于" Click="OnAboutSettingsTabClick" />
                                    <Button x:Name="SponsorsSettingsTabButton" Classes="TextTabButton" Content="赞助者" Click="OnSponsorsSettingsTabClick" />
                                    <Button x:Name="ContributorsSettingsTabButton" Classes="TextTabButton" Content="贡献者" Click="OnContributorsSettingsTabClick" />
                                </StackPanel>
                                <Grid Grid.Row="1">
                                    <Grid x:Name="SettingsBlankPanel" />
                                    <ScrollViewer x:Name="SettingsServerPanel" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                        <StackPanel Spacing="10">
                                            <Border Classes="ConfigCard">
                                                <StackPanel Spacing="10">
                                                    <TextBlock x:Name="SettingsServerDirectoryTitleTextBlock" Classes="ConfigSectionTitle" Text="目录路径" />
                                                    <Grid RowDefinitions="Auto" ColumnDefinitions="86,*,Auto" RowSpacing="10" ColumnSpacing="10">
                                                        <TextBlock x:Name="SettingsWorkspaceDirectoryLabelTextBlock" Grid.Row="0" Classes="ConfigFieldLabel" VerticalAlignment="Center" Text="工作目录" />
                                                        <TextBox x:Name="SettingsWorkspaceDirectoryTextBox" Grid.Row="0" Grid.Column="1" Classes="CompactInput" />
                                                        <Button x:Name="SettingsBrowseWorkspaceDirectoryButton" Grid.Row="0" Grid.Column="2" Classes="SecondaryActionButton" Content="浏览" Click="OnSettingsBrowseWorkspaceDirectoryClick" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                            <Border Classes="ConfigCard">
                                                <StackPanel Spacing="10">
                                                    <TextBlock x:Name="SettingsServerAutomationTitleTextBlock" Classes="ConfigSectionTitle" Text="启动与托盘" />
                                                    <WrapPanel Orientation="Horizontal">
                                                        <ToggleSwitch x:Name="SettingsStartWithWindowsCheckBox" Classes="ConfigCheck" />
                                                        <ToggleSwitch x:Name="SettingsCloseToTrayCheckBox" Classes="ConfigCheck" />
                                                        <ToggleSwitch x:Name="SettingsStartHiddenCheckBox" Classes="ConfigCheck" />
                                                        <ToggleSwitch x:Name="SettingsAutoStartOsqCheckBox" Classes="ConfigCheck" />
                                                        <ToggleSwitch x:Name="SettingsAutoStartRobotCheckBox" Classes="ConfigCheck" />
                                                        <ToggleSwitch x:Name="SettingsAutoStartFrpCheckBox" Classes="ConfigCheck" />
                                                        <ToggleSwitch x:Name="SettingsAutoStartThirdPartyFrpcCheckBox" Classes="ConfigCheck" />
                                                    </WrapPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="False">
                                                        <Button x:Name="SettingsServerSaveButton" Classes="ActionButton" Content="保存" Click="OnSettingsServerSaveClick" IsVisible="False" />
                                                        <Button x:Name="SettingsServerRefreshButton" Classes="SecondaryActionButton" Content="刷新" Click="OnSettingsServerRefreshClick" IsVisible="False" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="SettingsServerStatusTextBlock" Classes="ConfigHintText" IsVisible="False" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <Grid x:Name="SettingsAppearancePanel" IsVisible="False" RowDefinitions="Auto,Auto" RowSpacing="12" VerticalAlignment="Top" HorizontalAlignment="Left">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <TextBlock x:Name="SettingsLanguageLabelTextBlock" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource MainTextBrush}" />
                                            <ComboBox x:Name="SettingsLanguageComboBox" Grid.Column="1" Classes="Bordered SettingsGuideCombo" SelectionChanged="OnSettingsLanguageSelectionChanged" />
                                        </Grid>
                                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <TextBlock x:Name="SettingsThemeLabelTextBlock" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource MainTextBrush}" />
                                            <ComboBox x:Name="SettingsThemeComboBox" Grid.Column="1" Classes="Bordered SettingsGuideCombo" SelectionChanged="OnSettingsThemeSelectionChanged" />
                                        </Grid>
                                    </Grid>
                                    <ScrollViewer x:Name="SettingsNetworkPanel" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                        <StackPanel Spacing="10">
                                            <Border Classes="ConfigCard">
                                                <StackPanel Spacing="10">
                                                    <TextBlock x:Name="SettingsNetworkDownloadTitleTextBlock" Classes="ConfigSectionTitle" Text="下载网络" />
                                                    <WrapPanel Orientation="Horizontal">
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="SettingsThirdPartyServerLabelTextBlock" Classes="ConfigFieldLabel" Text="第三方服务端" />
                                                            <TextBox x:Name="SettingsThirdPartyServerTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormField">
                                                            <TextBlock x:Name="SettingsDownloadChunkCountLabelTextBlock" Classes="ConfigFieldLabel" Text="分片数量" />
                                                            <TextBox x:Name="SettingsDownloadChunkCountTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormField">
                                                            <TextBlock x:Name="SettingsChunkedDownloadLabelTextBlock" Classes="ConfigFieldLabel" Text="大文件分片下载" />
                                                            <ToggleSwitch x:Name="SettingsChunkedDownloadToggleSwitch" />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <ScrollViewer x:Name="SettingsAdvancedPanel" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                        <StackPanel Spacing="10">
                                            <Border Classes="ConfigCard">
                                                <StackPanel Spacing="10">
                                                    <TextBlock x:Name="SettingsAdvancedActionsTitleTextBlock" Classes="ConfigSectionTitle" Text="维护" />
                                                    <WrapPanel Orientation="Horizontal">
                                                        <Button x:Name="SettingsOpenLogButton" Classes="SecondaryActionButton" Content="打开软件日志" Click="OnSettingsOpenLogClick" Margin="0,0,8,8" />
                                                        <Button x:Name="SettingsClearDownloadCacheButton" Classes="SecondaryActionButton" Content="清空下载缓存" Click="OnSettingsClearDownloadCacheClick" Margin="0,0,8,8" />
                                                        <Button x:Name="SettingsResetAllButton" Classes="SecondaryActionButton" Content="重置所有设置" Click="OnSettingsResetAllClick" Margin="0,0,8,8" />
                                                    </WrapPanel>
                                                    <TextBlock x:Name="SettingsAdvancedStatusTextBlock" Classes="ConfigHintText" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <Border x:Name="SettingsAboutPanel" Classes="ConfigCard" IsVisible="False">
                                        <ContentControl x:Name="SettingsAboutContentHost" />
                                    </Border>
                                    <ScrollViewer x:Name="SettingsSponsorsPanel" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                        <StackPanel Spacing="10">
                                            <ItemsControl x:Name="SettingsSponsorsItemsControl">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" ItemWidth="270" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Classes="ConfigInnerCard" Width="270" Margin="0,0,10,10">
                                                            <Grid ColumnDefinitions="42,*" ColumnSpacing="10">
                                                                <Border Width="38" Height="38" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource CardHoverBrush}">
                                                                    <Grid>
                                                                        <Image Source="{Binding AvatarImage}" Stretch="UniformToFill" IsVisible="{Binding HasAvatar}" />
                                                                        <TextBlock Text="{Binding Initial}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasNoAvatar}" />
                                                                    </Grid>
                                                                </Border>
                                                                <StackPanel Grid.Column="1" Spacing="4">
                                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding AmountText}" FontSize="13" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding PlanText}" FontSize="12" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <ScrollViewer x:Name="SettingsContributorsPanel" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                        <StackPanel Spacing="10">
                                            <ItemsControl x:Name="SettingsContributorsItemsControl">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" ItemWidth="270" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Classes="ConfigInnerCard" Width="270" Margin="0,0,10,10">
                                                            <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="10">
                                                                <Border Width="38" Height="38" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource CardHoverBrush}">
                                                                    <Grid>
                                                                        <Image Source="{Binding AvatarImage}" Stretch="UniformToFill" IsVisible="{Binding HasAvatar}" />
                                                                        <TextBlock Text="{Binding Initial}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasNoAvatar}" />
                                                                    </Grid>
                                                                </Border>
                                                                <StackPanel Grid.Column="1" Spacing="4">
                                                                    <TextBlock Text="{Binding Login}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding ContributionsText}" FontSize="13" Foreground="{DynamicResource SubTextBrush}" />
                                                                </StackPanel>
                                                                <Button Grid.Column="2" Classes="DownloadTextButton" Content="打开" Tag="{Binding HtmlUrl}" Click="OnContributorOpenClick" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>

                            <Grid x:Name="ConnectionPanel" RowDefinitions="Auto,Auto,*" RowSpacing="8" IsVisible="False">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button x:Name="ConnectionFrpTabButton" Classes="TextTabButton" Content="内网穿透" Click="OnConnectionFrpTabClick" />
                                    <Button x:Name="ConnectionOpenInfoTabButton" Classes="TextTabButton" Content="开放信息" Click="OnConnectionOpenInfoTabClick" />
                                    <Button x:Name="ConnectionRobotTabButton" Classes="TextTabButton" Content="QQ机器人" Click="OnConnectionRobotTabClick" />
                                    <Button x:Name="ConnectionAuthTabButton" Classes="TextTabButton" Content="认证" Click="OnConnectionAuthTabClick" />
                                </StackPanel>
                                <TextBlock x:Name="ConnectionStatusTextBlock" Grid.Row="1" Classes="ConfigHintText" IsVisible="False" />
                                <Grid Grid.Row="2">
                                    <ScrollViewer x:Name="ConnectionFrpPanel" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="8">
                                                <Button x:Name="ConnectionFrpSaveButton" Classes="ActionButton" Content="保存" Click="OnConnectionFrpSaveClick" IsVisible="False" />
                                                <Button x:Name="ConnectionFrpRefreshButton" Grid.Column="1" Classes="SecondaryActionButton" Content="刷新" Click="OnConnectionRefreshClick" IsVisible="False" />
                                                <Button x:Name="ConnectionFrpImportButton" Classes="SecondaryActionButton" Content="导入frpc" Click="OnConnectionFrpImportClick" />
                                                <Button x:Name="ConnectionFrpToggleButton" Grid.Column="1" Classes="SecondaryActionButton" Content="启动常规" Click="OnConnectionFrpToggleClick" />
                                                <Button x:Name="ConnectionFrpEditTomlButton" Grid.Column="2" Classes="SecondaryActionButton" Content="编辑常规TOML" Click="OnConnectionFrpEditTomlClick" />
                                                <Button x:Name="ConnectionThirdPartyFrpcImportButton" Grid.Column="3" Classes="SecondaryActionButton" Content="导入第三方frpc" Click="OnConnectionThirdPartyFrpcImportClick" />
                                                <Button x:Name="ConnectionThirdPartyFrpcToggleButton" Grid.Column="4" Classes="SecondaryActionButton" Content="启动第三方" Click="OnConnectionThirdPartyFrpcToggleClick" />
                                                <Button x:Name="ConnectionThirdPartyFrpcEditTomlButton" Grid.Column="5" Classes="SecondaryActionButton" Content="编辑第三方TOML" Click="OnConnectionThirdPartyFrpcEditTomlClick" />
                                            </Grid>
                                            <Border Classes="ConfigCard">
                                                <StackPanel Spacing="10">
                                                    <TextBlock x:Name="ConnectionFrpTitleTextBlock" Classes="ConfigSectionTitle" Text="内网穿透配置" IsVisible="False" />
                                                    <WrapPanel Orientation="Horizontal">
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="ConnectionFrpCommandLabelTextBlock" Classes="ConfigFieldLabel" Text="常规启动命令" />
                                                            <TextBox x:Name="ConnectionFrpCommandTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormField">
                                                            <TextBlock x:Name="ConnectionThirdPartyFrpcModeLabelTextBlock" Classes="ConfigFieldLabel" Text="第三方模式" />
                                                            <ComboBox x:Name="ConnectionThirdPartyFrpcModeComboBox" Classes="CompactCombo" SelectionChanged="OnConnectionThirdPartyFrpcModeSelectionChanged">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="ConnectionThirdPartyFrpcCommandLabelTextBlock" Classes="ConfigFieldLabel" Text="第三方启动命令" />
                                                            <TextBox x:Name="ConnectionThirdPartyFrpcCommandTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <ScrollViewer x:Name="ConnectionOpenInfoPanel" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="8">
                                                <Button x:Name="OsqSaveButton" Classes="ActionButton" Content="保存" Click="OnOsqSaveClick" IsVisible="False" />
                                                <Button x:Name="OsqRefreshButton" Grid.Column="1" Classes="SecondaryActionButton" Content="刷新" Click="OnConnectionRefreshClick" IsVisible="False" />
                                                <Button x:Name="OsqToggleButton" Classes="SecondaryActionButton" Content="启动" Click="OnOsqToggleClick" />
                                            </Grid>
                                            <Border Classes="ConfigCard">
                                                <StackPanel Spacing="10">
                                                    <TextBlock x:Name="OsqTitleTextBlock" Classes="ConfigSectionTitle" Text="开放信息（OpenServerQuery）" IsVisible="False" />
                                                    <WrapPanel Orientation="Horizontal">
                                                        <ToggleSwitch x:Name="OsqEnabledCheckBox" Classes="ConfigCheck" />
                                                        <ToggleSwitch x:Name="OsqAllowInsecureHttpCheckBox" Classes="ConfigCheck" />
                                                    </WrapPanel>
                                                    <WrapPanel Orientation="Horizontal">
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="OsqListenPrefixLabelTextBlock" Classes="ConfigFieldLabel" Text="监听地址" />
                                                            <TextBox x:Name="OsqListenPrefixTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormField">
                                                            <TextBlock x:Name="OsqRequestTimeoutLabelTextBlock" Classes="ConfigFieldLabel" Text="请求超时秒数" />
                                                            <NumericUpDown x:Name="OsqRequestTimeoutNumericUpDown" Classes="CompactNumber" Minimum="3" Maximum="60" />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                    <WrapPanel Orientation="Horizontal">
                                                        <ToggleSwitch x:Name="OsqIncludeServerInfoCheckBox" Classes="ConfigCheck" />
                                                        <ToggleSwitch x:Name="OsqIncludePlayersCheckBox" Classes="ConfigCheck" />
                                                        <ToggleSwitch x:Name="OsqIncludeEventsCheckBox" Classes="ConfigCheck" />
                                                        <ToggleSwitch x:Name="OsqIncludeChatsCheckBox" Classes="ConfigCheck" />
                                                        <ToggleSwitch x:Name="OsqIncludeNotificationsCheckBox" Classes="ConfigCheck" />
                                                        <ToggleSwitch x:Name="OsqIncludeMapCheckBox" Classes="ConfigCheck" />
                                                    </WrapPanel>
                                                    <StackPanel Spacing="8">
                                                        <Grid ColumnDefinitions="420,420" ColumnSpacing="10">
                                                            <TextBlock x:Name="OsqEndpointHostLabelTextBlock" Classes="ConfigFieldLabel" Text="上报端点" />
                                                            <TextBlock x:Name="OsqEndpointTokenLabelTextBlock" Grid.Column="1" Classes="ConfigFieldLabel" Text="端点令牌" />
                                                        </Grid>
                                                        <StackPanel x:Name="OsqEndpointRowsHost" Spacing="8" />
                                                        <Button
                                                            x:Name="OsqEndpointAddButton"
                                                            Classes="SecondaryActionButton"
                                                            Width="850"
                                                            HorizontalAlignment="Left"
                                                            Content="添加"
                                                            Click="OnOsqEndpointAddClick" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <ScrollViewer x:Name="ConnectionRobotPanel" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="8">
                                                <Button x:Name="RobotSaveButton" Classes="ActionButton" Content="保存" Click="OnRobotSaveClick" IsVisible="False" />
                                                <Button x:Name="RobotRefreshButton" Grid.Column="1" Classes="SecondaryActionButton" Content="刷新" Click="OnConnectionRefreshClick" IsVisible="False" />
                                                <Button x:Name="RobotToggleButton" Classes="SecondaryActionButton" Content="启动" Click="OnRobotToggleClick" />
                                            </Grid>
                                            <Border Classes="ConfigCard">
                                                <StackPanel Spacing="10">
                                                    <TextBlock x:Name="RobotConfigTitleTextBlock" Classes="ConfigSectionTitle" Text="QQ机器人配置" IsVisible="False" />
                                                    <WrapPanel Orientation="Horizontal">
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="RobotOneBotLabelTextBlock" Classes="ConfigFieldLabel" Text="OneBot WebSocket" />
                                                            <TextBox x:Name="RobotOneBotTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormField">
                                                            <TextBlock x:Name="RobotAccessTokenLabelTextBlock" Classes="ConfigFieldLabel" Text="访问令牌" />
                                                            <TextBox x:Name="RobotAccessTokenTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormField">
                                                            <TextBlock x:Name="RobotReconnectLabelTextBlock" Classes="ConfigFieldLabel" Text="重连间隔秒数" />
                                                            <NumericUpDown x:Name="RobotReconnectNumericUpDown" Classes="CompactNumber" Minimum="1" Maximum="120" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormField">
                                                            <TextBlock x:Name="RobotPollIntervalLabelTextBlock" Classes="ConfigFieldLabel" Text="轮询间隔秒数" />
                                                            <NumericUpDown x:Name="RobotPollIntervalNumericUpDown" Classes="CompactNumber" Minimum="0.2" Maximum="30" Increment="0.2" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="RobotDatabasePathLabelTextBlock" Classes="ConfigFieldLabel" Text="数据库路径" />
                                                            <TextBox x:Name="RobotDatabasePathTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormField">
                                                            <TextBlock x:Name="RobotDefaultEncodingLabelTextBlock" Classes="ConfigFieldLabel" Text="默认编码" />
                                                            <TextBox x:Name="RobotDefaultEncodingTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormField">
                                                            <TextBlock x:Name="RobotFallbackEncodingLabelTextBlock" Classes="ConfigFieldLabel" Text="回退编码" />
                                                            <TextBox x:Name="RobotFallbackEncodingTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormField">
                                                            <TextBlock x:Name="RobotOsqPollLabelTextBlock" Classes="ConfigFieldLabel" Text="OSQ轮询秒数" />
                                                            <NumericUpDown x:Name="RobotOsqPollNumericUpDown" Classes="CompactNumber" Minimum="3" Maximum="300" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormField">
                                                            <TextBlock x:Name="RobotOsqTimeoutLabelTextBlock" Classes="ConfigFieldLabel" Text="OSQ超时秒数" />
                                                            <NumericUpDown x:Name="RobotOsqTimeoutNumericUpDown" Classes="CompactNumber" Minimum="3" Maximum="60" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="RobotSuperUsersLabelTextBlock" Classes="ConfigFieldLabel" Text="超级管理员 QQ" />
                                                            <TextBox x:Name="RobotSuperUsersTextBox" Classes="MultiLineInput" Height="72" AcceptsReturn="True" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                    <TextBlock x:Name="RobotOsqSourceHintTextBlock" Classes="ConfigHintText" Text="OSQ 来源由“开放信息”页面统一接收，机器人不再单独监听端口。" IsVisible="False" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <ScrollViewer x:Name="ConnectionAuthPanel" IsVisible="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="212,Auto,Auto,Auto,*" ColumnSpacing="8">
                                                <ComboBox x:Name="AuthProfileComboBox" Grid.Column="0" Classes="CompactCombo" SelectionChanged="OnAuthProfileSelectionChanged">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Button x:Name="AuthSaveButton" Grid.Column="1" Classes="ActionButton" Content="保存" Click="OnAuthSaveClick" />
                                                <Button x:Name="AuthRefreshButton" Grid.Column="2" Classes="SecondaryActionButton" Content="刷新" Click="OnAuthRefreshClick" />
                                                <Button x:Name="AuthDeployButton" Grid.Column="3" Classes="SecondaryActionButton" Content="部署认证模组" Click="OnAuthDeployClick" />
                                            </Grid>
                                            <TextBlock x:Name="AuthStatusTextBlock" Classes="ConfigHintText" TextWrapping="Wrap" />
                                            <Border Classes="ConfigCard">
                                                <StackPanel Spacing="10">
                                                    <WrapPanel Orientation="Horizontal">
                                                        <ToggleSwitch x:Name="AuthEnabledCheckBox" Classes="ConfigCheck" />
                                                        <StackPanel Classes="ConfigFormField">
                                                            <TextBlock x:Name="AuthLoginTimeoutLabelTextBlock" Classes="ConfigFieldLabel" Text="登录超时秒数" />
                                                            <NumericUpDown x:Name="AuthLoginTimeoutNumericUpDown" Classes="CompactNumber" Minimum="10" Maximum="600" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormField">
                                                            <TextBlock x:Name="AuthRememberSessionLabelTextBlock" Classes="ConfigFieldLabel" Text="会话记住分钟" />
                                                            <NumericUpDown x:Name="AuthRememberSessionNumericUpDown" Classes="CompactNumber" Minimum="0" Maximum="1440" />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                    <WrapPanel Orientation="Horizontal">
                                                        <ToggleSwitch x:Name="AuthDiscourseEnabledCheckBox" Classes="ConfigCheck" />
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="AuthDiscourseBaseUrlLabelTextBlock" Classes="ConfigFieldLabel" Text="Discourse 地址" />
                                                            <TextBox x:Name="AuthDiscourseBaseUrlTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="AuthDiscourseSecretLabelTextBlock" Classes="ConfigFieldLabel" Text="共享密钥" />
                                                            <TextBox x:Name="AuthDiscourseSecretTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="AuthDiscoursePublicCallbackLabelTextBlock" Classes="ConfigFieldLabel" Text="公开回调地址" />
                                                            <TextBox x:Name="AuthDiscoursePublicCallbackTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                        <StackPanel Classes="ConfigFormFieldWide">
                                                            <TextBlock x:Name="AuthDiscourseListenPrefixLabelTextBlock" Classes="ConfigFieldLabel" Text="本地监听地址" />
                                                            <TextBox x:Name="AuthDiscourseListenPrefixTextBox" Classes="CompactInput" />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border Classes="ConfigCard">
                                                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                                                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                                        <TextBlock x:Name="AuthPlayersTitleTextBlock" Classes="ConfigSectionTitle" Text="玩家认证数据" />
                                                        <Button x:Name="AuthRefreshPlayersButton" Grid.Column="1" Classes="SecondaryActionButton" Content="刷新玩家" Click="OnAuthRefreshPlayersClick" />
                                                    </Grid>
                                                    <Grid Grid.Row="1" RowDefinitions="Auto,*" Height="190">
                                                        <Border Grid.Row="0" Classes="TableHeader">
                                                            <Grid ColumnDefinitions="1.5*,1.4*,1.4*,1*,1.2*,Auto" ColumnSpacing="8">
                                                                <TextBlock Classes="TableHeaderText" Text="玩家" />
                                                                <TextBlock Grid.Column="1" Classes="TableHeaderText" Text="注册" />
                                                                <TextBlock Grid.Column="2" Classes="TableHeaderText" Text="最后登录" />
                                                                <TextBlock Grid.Column="3" Classes="TableHeaderText" Text="密码" />
                                                                <TextBlock Grid.Column="4" Classes="TableHeaderText" Text="Discourse" />
                                                                <TextBlock Grid.Column="5" Classes="TableHeaderText" Text="操作" HorizontalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                        <Border Grid.Row="1" Classes="TableBody">
                                                            <ListBox x:Name="AuthPlayersListBox" Classes="FlatList TableList">
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid ColumnDefinitions="1.5*,1.4*,1.4*,1*,1.2*,Auto" ColumnSpacing="8" MinHeight="38">
                                                                            <StackPanel Spacing="2">
                                                                                <TextBlock Text="{Binding PlayerName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                                <TextBlock Text="{Binding PlayerUid}" FontSize="11" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
                                                                            </StackPanel>
                                                                            <StackPanel Grid.Column="1" Spacing="2">
                                                                                <TextBlock Text="{Binding RegisteredAtText}" TextTrimming="CharacterEllipsis" />
                                                                                <TextBlock Text="{Binding RegisteredIp}" FontSize="11" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
                                                                            </StackPanel>
                                                                            <StackPanel Grid.Column="2" Spacing="2">
                                                                                <TextBlock Text="{Binding LastLoginAtText}" TextTrimming="CharacterEllipsis" />
                                                                                <TextBlock Text="{Binding LastIp}" FontSize="11" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
                                                                            </StackPanel>
                                                                            <TextBlock Grid.Column="3" Classes="TableCellText" Text="{Binding PasswordStateText}" />
                                                                            <TextBlock Grid.Column="4" Classes="TableCellText" Text="{Binding DiscourseUsername}" />
                                                                            <Button Grid.Column="5" Classes="SecondaryActionButton" Tag="{Binding}" Content="清空密码" Click="OnAuthClearPlayerPasswordClick" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                            </ListBox>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" MinHeight="52" Background="{DynamicResource FooterBackgroundBrush}" BorderBrush="Transparent" BorderThickness="0">
                        <Grid Margin="14,0,14,0" ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="HomeNavButton" Classes="FooterNavButton" Click="OnHomeNavClick" />
                                <Button x:Name="MonitorNavButton" Classes="FooterNavButton" Click="OnMonitorNavClick" />
                                <Button x:Name="ConsoleNavButton" Classes="FooterNavButton" Click="OnConsoleNavClick" />
                                <Button x:Name="InstanceManageNavButton" Classes="FooterNavButton" Click="OnInstanceManageNavClick" />
                                <Button x:Name="ConnectionNavButton" Classes="FooterNavButton" Click="OnConnectionNavClick" />
                                <Button x:Name="SettingsNavButton" Classes="FooterNavButton" Click="OnSettingsNavClick" />
                            </StackPanel>

                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <Button
                                    x:Name="LaunchServerButton"
                                    Click="OnLaunchServerClick"
                                    PointerEntered="OnLaunchServerPointerEntered"
                                    PointerExited="OnLaunchServerPointerExited">
                                    <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="7" VerticalAlignment="Center">
                                        <Path
                                            x:Name="LaunchActionIconPath"
                                            Width="13"
                                            Height="13"
                                            Stretch="Uniform"
                                            Fill="#FFFFFF"
                                            Data="M187.2 100.9C174.8 94.1 159.8 94.4 147.6 101.6C135.4 108.8 128 121.9 128 136L128 504C128 518.1 135.5 531.2 147.6 538.4C159.7 545.6 174.8 545.9 187.2 539.1L523.2 355.1C536 348.1 544 334.6 544 320C544 305.4 536 291.9 523.2 284.9L187.2 100.9z" />
                                        <TextBlock
                                            x:Name="LaunchActionTextBlock"
                                            Grid.Column="1"
                                            Text="启动服务器"
                                            VerticalAlignment="Center"
                                            FontSize="15"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource LaunchButtonTextBrush}" />
                                        <Border
                                            x:Name="LaunchSelectionPillHost"
                                            Grid.Column="2"
                                            Height="24"
                                            VerticalAlignment="Center">
                                            <Border
                                                Height="24"
                                                MinWidth="122"
                                                MaxWidth="168"
                                                Padding="8,0"
                                                CornerRadius="4"
                                                Background="{DynamicResource LaunchSelectionPillBrush}"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    x:Name="LaunchSelectionSummaryTextBlock"
                                                    Text="未选择档案 | 未固定存档"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Stretch"
                                                    TextAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource LaunchSelectionPillTextBrush}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </Border>
                                    </Grid>
                                </Button>

                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
