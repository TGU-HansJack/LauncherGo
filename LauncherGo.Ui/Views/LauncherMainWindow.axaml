<Window
    x:Class="LauncherGo.Ui.Views.LauncherMainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="980"
    Height="580"
    MinWidth="980"
    MinHeight="580"
    MaxWidth="980"
    MaxHeight="580"
    CanResize="False"
    WindowDecorations="None"
    Background="Transparent"
    TransparencyLevelHint="Transparent"
    TransparencyBackgroundFallback="#FFFFFF"
    Icon="avares://LauncherGo.Ui/Assets/app-icon.ico"
    WindowStartupLocation="CenterScreen"
    Title="LauncherGo">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WindowSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="WindowBorderBrush" Color="#AAB2BC" />
                    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="FooterBackgroundBrush" Color="#F8F9FA" />
                    <SolidColorBrush x:Key="SplitLineBrush" Color="#E8EAED" />
                    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardHoverBrush" Color="#F3F5F7" />
                    <SolidColorBrush x:Key="CardSelectedBrush" Color="#EAF2FF" />
                    <SolidColorBrush x:Key="MainTextBrush" Color="#111111" />
                    <SolidColorBrush x:Key="SubTextBrush" Color="#6A7380" />
                    <SolidColorBrush x:Key="PrimaryLineBrush" Color="#2D6CDF" />
                    <SolidColorBrush x:Key="SecondaryLineBrush" Color="#16A34A" />
                    <SolidColorBrush x:Key="GridLineBrush" Color="#E3E8EE" />
                    <SolidColorBrush x:Key="NavSelectedBrush" Color="#1677FF" />
                    <SolidColorBrush x:Key="NavSelectedTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="NavNormalTextBrush" Color="#111111" />
                    <SolidColorBrush x:Key="NavDisabledTextBrush" Color="#8A8A8A" />
                    <SolidColorBrush x:Key="LaunchButtonBrush" Color="#1677FF" />
                    <SolidColorBrush x:Key="LaunchButtonHoverBrush" Color="#0F6BEA" />
                    <SolidColorBrush x:Key="LaunchButtonPressedBrush" Color="#0A5CC8" />
                    <SolidColorBrush x:Key="LaunchButtonTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ControlHoverBrush" Color="#ECEFF2" />
                    <SolidColorBrush x:Key="HeaderIconBrush" Color="#7D8793" />
                    <SolidColorBrush x:Key="HeaderIconHoverBrush" Color="#111111" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WindowSurfaceBrush" Color="#171C22" />
                    <SolidColorBrush x:Key="WindowBorderBrush" Color="#485361" />
                    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#1E252D" />
                    <SolidColorBrush x:Key="FooterBackgroundBrush" Color="#1D242C" />
                    <SolidColorBrush x:Key="SplitLineBrush" Color="#2E3945" />
                    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1A2027" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#232C35" />
                    <SolidColorBrush x:Key="CardHoverBrush" Color="#2B3642" />
                    <SolidColorBrush x:Key="CardSelectedBrush" Color="#2A3F5A" />
                    <SolidColorBrush x:Key="MainTextBrush" Color="#E6EDF6" />
                    <SolidColorBrush x:Key="SubTextBrush" Color="#A0ADBC" />
                    <SolidColorBrush x:Key="PrimaryLineBrush" Color="#7CB3FF" />
                    <SolidColorBrush x:Key="SecondaryLineBrush" Color="#60D394" />
                    <SolidColorBrush x:Key="GridLineBrush" Color="#334050" />
                    <SolidColorBrush x:Key="NavSelectedBrush" Color="#1677FF" />
                    <SolidColorBrush x:Key="NavSelectedTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="NavNormalTextBrush" Color="#E6EDF6" />
                    <SolidColorBrush x:Key="NavDisabledTextBrush" Color="#6F7886" />
                    <SolidColorBrush x:Key="LaunchButtonBrush" Color="#1677FF" />
                    <SolidColorBrush x:Key="LaunchButtonHoverBrush" Color="#3A8BFF" />
                    <SolidColorBrush x:Key="LaunchButtonPressedBrush" Color="#0F6BEA" />
                    <SolidColorBrush x:Key="LaunchButtonTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ControlHoverBrush" Color="#2D3743" />
                    <SolidColorBrush x:Key="HeaderIconBrush" Color="#B4BDCA" />
                    <SolidColorBrush x:Key="HeaderIconHoverBrush" Color="#E6EDF6" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Path.IconPath">
            <Setter Property="Fill" Value="{DynamicResource HeaderIconBrush}" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>

        <Style Selector="Button.TitleButton">
            <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.TitleButton /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.TitleButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        </Style>
        <Style Selector="Button.TitleButton:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        </Style>

        <Style Selector="Button.HeaderIconButton">
            <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.HeaderIconButton /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.HeaderIconButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        </Style>
        <Style Selector="Button.HeaderIconButton:pointerover Path.IconPath">
            <Setter Property="Fill" Value="{DynamicResource HeaderIconHoverBrush}" />
        </Style>
        <Style Selector="Button.HeaderIconButton:pressed Path.IconPath">
            <Setter Property="Fill" Value="{DynamicResource HeaderIconHoverBrush}" />
        </Style>

        <Style Selector="Button.FooterNavButton">
            <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource NavNormalTextBrush}" />
        </Style>
        <Style Selector="Button.FooterNavButton /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.FooterNavButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        </Style>
        <Style Selector="Button.FooterNavButton.selected">
            <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource NavSelectedTextBrush}" />
        </Style>
        <Style Selector="Button.FooterNavButton.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}" />
        </Style>
        <Style Selector="Button.FooterNavButton:disabled">
            <Setter Property="Foreground" Value="{DynamicResource NavDisabledTextBrush}" />
        </Style>

        <Style Selector="Button.StatusCardButton">
            <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Width" Value="318" />
            <Setter Property="Height" Value="94" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.StatusCardButton /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.StatusCardButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
        </Style>
        <Style Selector="Button.StatusCardButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.StatusCardButton.selected">
            <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.StatusCardButton.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Button#LaunchServerButton">
            <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="{DynamicResource LaunchButtonBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource LaunchButtonTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CornerRadius" Value="17" />
        </Style>
        <Style Selector="Button#LaunchServerButton /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Background" Value="{DynamicResource LaunchButtonBrush}" />
        </Style>
        <Style Selector="Button#LaunchServerButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource LaunchButtonHoverBrush}" />
        </Style>
        <Style Selector="Button#LaunchServerButton:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource LaunchButtonPressedBrush}" />
        </Style>

        <Style Selector="Border#LaunchOptionsContainer">
            <Setter Property="Width" Value="0" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.18" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border#LaunchOptionsContainer.expanded">
            <Setter Property="Width" Value="256" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>

        <Style Selector="ComboBox.LaunchOptionCombo">
            <Setter Property="Width" Value="122" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Styles>

    <Grid Background="Transparent">
        <Border CornerRadius="8" Background="{DynamicResource WindowBorderBrush}">
            <Border Margin="1" CornerRadius="7" ClipToBounds="True" Background="{DynamicResource WindowSurfaceBrush}">
                <Grid RowDefinitions="58,*,46">
                    <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="Transparent" BorderThickness="0">
                        <Grid Margin="14,0,10,0" ColumnDefinitions="Auto,*,Auto">
                            <Button x:Name="TitleHomeButton" Classes="TitleButton" Content="LauncherGo" Click="OnHomeNavClick" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button x:Name="RepositoryButton" Classes="HeaderIconButton" Click="OnRepositoryClick" ToolTip.Tip="仓库">
                                    <Viewbox Width="16" Height="16">
                                        <Path Classes="IconPath" Data="M176 168C189.3 168 200 157.3 200 144C200 130.7 189.3 120 176 120C162.7 120 152 130.7 152 144C152 157.3 162.7 168 176 168zM256 144C256 176.8 236.3 205 208 217.3L208 288L384 288C410.5 288 432 266.5 432 240L432 217.3C403.7 205 384 176.8 384 144C384 99.8 419.8 64 464 64C508.2 64 544 99.8 544 144C544 176.8 524.3 205 496 217.3L496 240C496 301.9 445.9 352 384 352L208 352L208 422.7C236.3 435 256 463.2 256 496C256 540.2 220.2 576 176 576C131.8 576 96 540.2 96 496C96 463.2 115.7 435 144 422.7L144 217.4C115.7 205 96 176.8 96 144C96 99.8 131.8 64 176 64C220.2 64 256 99.8 256 144zM488 144C488 130.7 477.3 120 464 120C450.7 120 440 130.7 440 144C440 157.3 450.7 168 464 168C477.3 168 488 157.3 488 144zM176 520C189.3 520 200 509.3 200 496C200 482.7 189.3 472 176 472C162.7 472 152 482.7 152 496C152 509.3 162.7 520 176 520z" />
                                    </Viewbox>
                                </Button>
                                <Button x:Name="FeedbackButton" Classes="HeaderIconButton" Click="OnFeedbackClick" ToolTip.Tip="反馈">
                                    <Viewbox Width="16" Height="16">
                                        <Path Classes="IconPath" Data="M320 576C178.6 576 64 461.4 64 320C64 178.6 178.6 64 320 64C461.4 64 576 178.6 576 320C576 461.4 461.4 576 320 576zM320 112C205.1 112 112 205.1 112 320C112 434.9 205.1 528 320 528C434.9 528 528 434.9 528 320C528 205.1 434.9 112 320 112zM320 416C267 416 224 373 224 320C224 267 267 224 320 224C373 224 416 267 416 320C416 373 373 416 320 416z" />
                                    </Viewbox>
                                </Button>
                                <Button x:Name="SponsorButton" Classes="HeaderIconButton" Click="OnSponsorClick" ToolTip.Tip="赞助">
                                    <Viewbox Width="16" Height="16">
                                        <Path Classes="IconPath" Data="M235.5 102.8C256.3 68 300.5 54 338 71.6L345.2 75.4C380 96.3 394 140.5 376.4 178L376.4 178L362.3 208L472 208L479.4 208.4C515.7 212.1 544 242.8 544 280C544 293.2 540.4 305.4 534.2 316C540.3 326.6 543.9 338.8 544 352C544 370.3 537.1 386.8 526 399.5C527.3 404.8 528 410.3 528 416C528 441.1 515.1 463 495.8 475.9C493.9 511.4 466.4 540.1 431.4 543.6L424 544L319.9 544C301.9 544 284 540.6 267.3 534.1L260.2 531.1L259.5 530.8L252.9 527.6L252.2 527.3L240 520.8C227.7 514.3 216.7 506.1 207.1 496.7C203 523.6 179.8 544.1 151.8 544.1L119.8 544.1C88.9 544.1 63.8 519 63.8 488.1L64 264C64 233.1 89.1 208 120 208L152 208C162.8 208 172.9 211.1 181.5 216.5L231.6 110L232.2 108.8L234.9 103.8L235.5 102.9zM120 256C115.6 256 112 259.6 112 264L112 488C112 492.4 115.6 496 120 496L152 496C156.4 496 160 492.4 160 488L160 264C160 259.6 156.4 256 152 256L120 256zM317.6 115C302.8 108.1 285.3 113.4 276.9 127L274.7 131L217.9 251.9C214.4 259.4 212.4 267.4 211.9 275.6L211.8 279.8L211.8 392.7L212 400.6C214.4 433.3 233.4 462.7 262.7 478.3L274.2 484.4L280.5 487.5C292.9 493.1 306.3 496 319.9 496L424 496L426.4 495.9C438.5 494.7 448 484.4 448 472L447.8 469.4C447.7 468.5 447.6 467.7 447.4 466.8C444.7 454.7 451.7 442.6 463.4 438.8C473.1 435.7 480 426.6 480 416C480 411.7 478.9 407.8 476.9 404.2C470.6 393.1 474.1 379 484.9 372.2C491.7 367.9 496.1 360.4 496.1 352C496.1 344.9 493 338.5 487.9 334C482.7 329.4 479.7 322.9 479.7 316C479.7 309.1 482.7 302.6 487.9 298C493 293.5 496.1 287.1 496.1 280L496 277.6C494.9 266.3 485.9 257.3 474.6 256.2L472.2 256.1L324.7 256.1C316.5 256.1 308.9 251.9 304.5 245C300.1 238.1 299.5 229.3 303 221.9L333 157.6C340 142.6 334.4 124.9 320.5 116.6L317.6 115z" />
                                    </Viewbox>
                                </Button>
                                <Border Width="1" Height="16" Background="{DynamicResource SplitLineBrush}" Margin="4,0" />
                                <Button x:Name="MinimizeButton" Classes="HeaderIconButton" Click="OnMinimizeClick" ToolTip.Tip="缩小">
                                    <Viewbox Width="16" Height="16">
                                        <Path Classes="IconPath" Data="M96 320C96 302.3 110.3 288 128 288L512 288C529.7 288 544 302.3 544 320C544 337.7 529.7 352 512 352L128 352C110.3 352 96 337.7 96 320z" />
                                    </Viewbox>
                                </Button>
                                <Button x:Name="FullScreenButton" Classes="HeaderIconButton" Click="OnToggleMaximizeClick" ToolTip.Tip="全屏">
                                    <Viewbox Width="16" Height="16">
                                        <Path Classes="IconPath" Data="M512 112C520.8 112 528 119.2 528 128L528 512C528 520.8 520.8 528 512 528L128 528C119.2 528 112 520.8 112 512L112 128C112 119.2 119.2 112 128 112L512 112zM128 64C92.7 64 64 92.7 64 128L64 512C64 547.3 92.7 576 128 576L512 576C547.3 576 576 547.3 576 512L576 128C576 92.7 547.3 64 512 64L128 64z" />
                                    </Viewbox>
                                </Button>
                                <Button x:Name="CloseButton" Classes="HeaderIconButton" Click="OnCloseClick" ToolTip.Tip="关闭">
                                    <Viewbox Width="16" Height="16">
                                        <Path Classes="IconPath" Data="M183.1 137.4C170.6 124.9 150.3 124.9 137.8 137.4C125.3 149.9 125.3 170.2 137.8 182.7L275.2 320L137.9 457.4C125.4 469.9 125.4 490.2 137.9 502.7C150.4 515.2 170.7 515.2 183.2 502.7L320.5 365.3L457.9 502.6C470.4 515.1 490.7 515.1 503.2 502.6C515.7 490.1 515.7 469.8 503.2 457.3L365.8 320L503.1 182.6C515.6 170.1 515.6 149.8 503.1 137.3C490.6 124.8 470.3 124.8 457.8 137.3L320.5 274.7L183.1 137.4z" />
                                    </Viewbox>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Margin="14,4,14,6" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="0" BorderBrush="Transparent" BorderThickness="0" Padding="12">
                        <Grid>
                            <Grid x:Name="HomePanel" ColumnDefinitions="330,*" ColumnSpacing="12">
                                <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" VerticalAlignment="Top">
                                    <Button x:Name="ServerStatusCard" Grid.Row="0" Classes="StatusCardButton" Click="OnServerStatusCardClick">
                                        <Grid ColumnDefinitions="78,*" ColumnSpacing="12">
                                            <Border Width="76" Height="50" BorderBrush="#111111" BorderThickness="1" Background="Transparent">
                                                <Canvas Width="76" Height="50" Background="Transparent" ClipToBounds="True">
                                                    <Polyline x:Name="ServerStatusThumbLinePrimary" Stroke="{DynamicResource PrimaryLineBrush}" StrokeThickness="1.4" />
                                                    <Polyline x:Name="ServerStatusThumbLineSecondary" Stroke="{DynamicResource SecondaryLineBrush}" StrokeThickness="1.4" />
                                                </Canvas>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock x:Name="ServerStatusCardTitleText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" />
                                                <TextBlock x:Name="ServerStatusCardValueText" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="RobotStatusCard" Grid.Row="1" Classes="StatusCardButton" Click="OnRobotStatusCardClick">
                                        <Grid ColumnDefinitions="78,*" ColumnSpacing="12">
                                            <Border Width="76" Height="50" BorderBrush="#111111" BorderThickness="1" Background="Transparent">
                                                <Canvas Width="76" Height="50" Background="Transparent" ClipToBounds="True">
                                                    <Polyline x:Name="RobotStatusThumbLinePrimary" Stroke="{DynamicResource PrimaryLineBrush}" StrokeThickness="1.4" />
                                                    <Polyline x:Name="RobotStatusThumbLineSecondary" Stroke="{DynamicResource SecondaryLineBrush}" StrokeThickness="1.4" />
                                                </Canvas>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock x:Name="RobotStatusCardTitleText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" />
                                                <TextBlock x:Name="RobotStatusCardValueText" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="OnlinePlayersCard" Grid.Row="2" Classes="StatusCardButton" Click="OnOnlinePlayersCardClick">
                                        <Grid ColumnDefinitions="78,*" ColumnSpacing="12">
                                            <Border Width="76" Height="50" BorderBrush="#111111" BorderThickness="1" Background="Transparent">
                                                <Canvas Width="76" Height="50" Background="Transparent" ClipToBounds="True">
                                                    <Polyline x:Name="OnlinePlayersThumbLinePrimary" Stroke="{DynamicResource PrimaryLineBrush}" StrokeThickness="1.4" />
                                                </Canvas>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock x:Name="OnlinePlayersCardTitleText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" />
                                                <TextBlock x:Name="OnlinePlayersCardValueText" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="NetworkStatusCard" Grid.Row="3" Classes="StatusCardButton" Click="OnNetworkStatusCardClick">
                                        <Grid ColumnDefinitions="78,*" ColumnSpacing="12">
                                            <Border Width="76" Height="50" BorderBrush="#111111" BorderThickness="1" Background="Transparent">
                                                <Canvas Width="76" Height="50" Background="Transparent" ClipToBounds="True">
                                                    <Polyline x:Name="NetworkStatusThumbLinePrimary" Stroke="{DynamicResource PrimaryLineBrush}" StrokeThickness="1.4" />
                                                </Canvas>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock x:Name="NetworkStatusCardTitleText" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" />
                                                <TextBlock x:Name="NetworkStatusCardValueText" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </Grid>

                                <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0" Padding="12">
                                    <Grid RowDefinitions="Auto,*,Auto,Auto">
                                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                            <TextBlock x:Name="ChartTitleText" Grid.Row="0" Grid.Column="0" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" />
                                            <TextBlock x:Name="ChartTopValueText" Grid.Row="0" Grid.Column="1" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource MainTextBrush}" VerticalAlignment="Bottom" />
                                            <TextBlock x:Name="ChartSummaryText" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0" FontSize="13" Foreground="{DynamicResource SubTextBrush}" />
                                        </Grid>

                                        <Grid Grid.Row="1" Margin="0,10,0,10" RowDefinitions="*,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                            <Grid Grid.Row="0" Grid.Column="0" Width="50" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" VerticalAlignment="Stretch">
                                                <TextBlock x:Name="YAxisLabelTop" Grid.Row="0" FontSize="11" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                <TextBlock x:Name="YAxisLabel2" Grid.Row="1" FontSize="11" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock x:Name="YAxisLabel3" Grid.Row="2" FontSize="11" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock x:Name="YAxisLabel4" Grid.Row="3" FontSize="11" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock x:Name="YAxisLabel5" Grid.Row="4" FontSize="11" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock x:Name="YAxisLabelBottom" Grid.Row="5" FontSize="11" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                            </Grid>
                                            <Border Grid.Row="0" Grid.Column="1" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0" Padding="8">
                                                <Viewbox Stretch="Fill">
                                                    <Canvas x:Name="ChartCanvas" Width="640" Height="248" Background="Transparent">
                                                        <Line StartPoint="0,0" EndPoint="640,0" Stroke="{DynamicResource GridLineBrush}" StrokeThickness="1" />
                                                        <Line StartPoint="0,50" EndPoint="640,50" Stroke="{DynamicResource GridLineBrush}" StrokeThickness="1" />
                                                        <Line StartPoint="0,100" EndPoint="640,100" Stroke="{DynamicResource GridLineBrush}" StrokeThickness="1" />
                                                        <Line StartPoint="0,150" EndPoint="640,150" Stroke="{DynamicResource GridLineBrush}" StrokeThickness="1" />
                                                        <Line StartPoint="0,200" EndPoint="640,200" Stroke="{DynamicResource GridLineBrush}" StrokeThickness="1" />
                                                        <Line StartPoint="0,248" EndPoint="640,248" Stroke="{DynamicResource GridLineBrush}" StrokeThickness="1" />

                                                        <Polyline x:Name="ChartLinePrimary" Stroke="{DynamicResource PrimaryLineBrush}" StrokeThickness="2" />
                                                        <Polyline x:Name="ChartLineSecondary" Stroke="{DynamicResource SecondaryLineBrush}" StrokeThickness="2" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>
                                            <TextBlock x:Name="ChartXAxisText" Grid.Row="1" Grid.Column="1" Margin="4,6,0,0" FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
                                        </Grid>

                                        <Grid x:Name="ChartDetailGrid" Grid.Row="2" Margin="0,0,0,8" ColumnDefinitions="*,*,*,*" RowDefinitions="Auto" ColumnSpacing="16">
                                            <StackPanel>
                                                <TextBlock x:Name="DetailOneLabelText" FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
                                                <TextBlock x:Name="DetailOneValueText" FontSize="18" Foreground="{DynamicResource MainTextBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock x:Name="DetailTwoLabelText" FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
                                                <TextBlock x:Name="DetailTwoValueText" FontSize="18" Foreground="{DynamicResource MainTextBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock x:Name="DetailThreeLabelText" FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
                                                <TextBlock x:Name="DetailThreeValueText" FontSize="18" Foreground="{DynamicResource MainTextBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3">
                                                <TextBlock x:Name="DetailFourLabelText" FontSize="12" Foreground="{DynamicResource SubTextBrush}" />
                                                <TextBlock x:Name="DetailFourValueText" FontSize="18" Foreground="{DynamicResource MainTextBrush}" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Grid.Row="3" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0" Padding="8" IsVisible="False" x:Name="EventTickerContainer">
                                            <Grid Height="24" ClipToBounds="True">
                                                <TextBlock x:Name="EventTickerCurrentText" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource MainTextBrush}" TextTrimming="CharacterEllipsis" RenderTransform="translate(0px,0px)">
                                                    <TextBlock.Transitions>
                                                        <Transitions>
                                                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" />
                                                        </Transitions>
                                                    </TextBlock.Transitions>
                                                </TextBlock>
                                                <TextBlock x:Name="EventTickerNextText" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource MainTextBrush}" TextTrimming="CharacterEllipsis" RenderTransform="translate(0px,24px)">
                                                    <TextBlock.Transitions>
                                                        <Transitions>
                                                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" />
                                                        </Transitions>
                                                    </TextBlock.Transitions>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid x:Name="ConsolePanel" IsVisible="False">
                                <TextBlock x:Name="ConsolePlaceholderText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="{DynamicResource SubTextBrush}" />
                            </Grid>
                            <Grid x:Name="ProfilePanel" IsVisible="False">
                                <TextBlock x:Name="ProfilePlaceholderText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="{DynamicResource SubTextBrush}" />
                            </Grid>
                            <Grid x:Name="DownloadPanel" IsVisible="False">
                                <TextBlock x:Name="DownloadPlaceholderText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="{DynamicResource SubTextBrush}" />
                            </Grid>
                            <Grid x:Name="SettingsPanel" IsVisible="False">
                                <TextBlock x:Name="SettingsPlaceholderText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Foreground="{DynamicResource SubTextBrush}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Background="{DynamicResource FooterBackgroundBrush}" BorderBrush="Transparent" BorderThickness="0">
                        <Grid Margin="14,0,14,0" ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="HomeNavButton" Classes="FooterNavButton" Click="OnHomeNavClick" />
                                <Button x:Name="ConsoleNavButton" Classes="FooterNavButton" Click="OnConsoleNavClick" />
                                <Button x:Name="ProfileNavButton" Classes="FooterNavButton" Click="OnProfileNavClick" />
                                <Button x:Name="DownloadNavButton" Classes="FooterNavButton" Click="OnDownloadNavClick" />
                                <Button x:Name="SettingsNavButton" Classes="FooterNavButton" Click="OnSettingsNavClick" />
                            </StackPanel>

                            <Border
                                Grid.Column="2"
                                Background="Transparent"
                                VerticalAlignment="Center"
                                PointerEntered="OnLaunchHoverAreaPointerEntered"
                                PointerExited="OnLaunchHoverAreaPointerExited">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border x:Name="LaunchOptionsContainer" Background="Transparent" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ComboBox x:Name="InstanceComboBox" Classes="Bordered Large LaunchOptionCombo" />
                                            <ComboBox x:Name="SaveComboBox" Classes="Bordered Large LaunchOptionCombo" />
                                        </StackPanel>
                                    </Border>
                                    <Button x:Name="LaunchServerButton" Click="OnLaunchServerClick" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
