<Window
    x:Class="LauncherGo.Ui.Views.GatewayBackendStatisticsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:LauncherGo.Ui.Views"
    Width="620"
    Height="780"
    MinWidth="460"
    MinHeight="460"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource StatisticsSurfaceBrush}"
    Icon="avares://LauncherGo.Ui/Assets/app-icon.ico">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="StatisticsSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="StatisticsTextBrush" Color="#111111" />
                    <SolidColorBrush x:Key="StatisticsSubTextBrush" Color="#64707D" />
                    <SolidColorBrush x:Key="StatisticsBorderBrush" Color="#D8DEE6" />
                    <SolidColorBrush x:Key="StatisticsHeaderBrush" Color="#F2F4F7" />
                    <SolidColorBrush x:Key="StatisticsBodyBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="StatisticsSurfaceBrush" Color="#191919" />
                    <SolidColorBrush x:Key="StatisticsTextBrush" Color="#F5F5F5" />
                    <SolidColorBrush x:Key="StatisticsSubTextBrush" Color="#B8C0C9" />
                    <SolidColorBrush x:Key="StatisticsBorderBrush" Color="#3B4149" />
                    <SolidColorBrush x:Key="StatisticsHeaderBrush" Color="#232323" />
                    <SolidColorBrush x:Key="StatisticsBodyBrush" Color="#191919" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Styles>
        <Style Selector="Button.CloseButton">
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Border.StatisticsTableHeader">
            <Setter Property="Background" Value="{DynamicResource StatisticsHeaderBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StatisticsBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4,4,0,0" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style Selector="Border.StatisticsTableBody">
            <Setter Property="Background" Value="{DynamicResource StatisticsBodyBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StatisticsBorderBrush}" />
            <Setter Property="BorderThickness" Value="1,0,1,1" />
            <Setter Property="CornerRadius" Value="0,0,4,4" />
            <Setter Property="Padding" Value="0,8,0,0" />
        </Style>
        <Style Selector="Border.StatisticsTableRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource StatisticsBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="TextBlock.StatisticsTableHeaderText">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource StatisticsTextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.StatisticsTableCellText">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource StatisticsTextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.StatisticsTableSubCellText">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource StatisticsSubTextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.DisconnectsTableHeader TextBlock">
            <Setter Property="ToolTip.Tip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Setter Property="ToolTip.Placement" Value="Top" />
            <Setter Property="ToolTip.VerticalOffset" Value="-8" />
        </Style>
        <Style Selector="Border.DisconnectsTableBody TextBlock">
            <Setter Property="ToolTip.Tip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Setter Property="ToolTip.Placement" Value="Top" />
            <Setter Property="ToolTip.VerticalOffset" Value="-8" />
        </Style>
    </Window.Styles>

    <Grid Margin="18" RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <StackPanel Spacing="3">
            <TextBlock x:Name="TitleTextBlock" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource StatisticsTextBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="AddressTextBlock" FontSize="12" Foreground="{DynamicResource StatisticsSubTextBrush}" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Classes="StatisticsTableHeader">
                        <Grid ColumnDefinitions="1.45*,*" ColumnSpacing="12">
                            <TextBlock x:Name="MetricHeaderTextBlock" Classes="StatisticsTableHeaderText" />
                            <TextBlock x:Name="ValueHeaderTextBlock" Grid.Column="1" Classes="StatisticsTableHeaderText" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Classes="StatisticsTableBody">
                        <ItemsControl x:Name="MetricItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:GatewayBackendStatisticItem">
                                    <Border Classes="StatisticsTableRow">
                                        <Grid ColumnDefinitions="1.45*,*" ColumnSpacing="12">
                                            <TextBlock Classes="StatisticsTableCellText" Text="{Binding Label}" />
                                            <TextBlock Grid.Column="1" Classes="StatisticsTableCellText" Text="{Binding Value}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>

                <TextBlock x:Name="DisconnectsTitleTextBlock" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource StatisticsTextBrush}" />
                <Grid RowDefinitions="Auto,*" MinHeight="130">
                    <Border Grid.Row="0" Classes="StatisticsTableHeader DisconnectsTableHeader">
                        <Grid ColumnDefinitions="148,112,*" ColumnSpacing="8">
                            <TextBlock x:Name="DisconnectTimeHeaderTextBlock" Classes="StatisticsTableHeaderText" />
                            <TextBlock x:Name="DisconnectTypeHeaderTextBlock" Grid.Column="1" Classes="StatisticsTableHeaderText" />
                            <TextBlock x:Name="DisconnectDetailsHeaderTextBlock" Grid.Column="2" Classes="StatisticsTableHeaderText" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Classes="StatisticsTableBody DisconnectsTableBody">
                        <ItemsControl x:Name="DisconnectItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:GatewayDisconnectItem">
                                    <Border Classes="StatisticsTableRow">
                                        <Grid ColumnDefinitions="148,112,*" ColumnSpacing="8">
                                            <TextBlock Classes="StatisticsTableSubCellText" Text="{Binding OccurredAtText}" />
                                            <TextBlock Grid.Column="1" Classes="StatisticsTableCellText" Text="{Binding TypeText}" />
                                            <TextBlock Grid.Column="2" Classes="StatisticsTableSubCellText" Text="{Binding DetailsText}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock x:Name="LogPathTextBlock" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource StatisticsSubTextBrush}" TextTrimming="CharacterEllipsis" />
            <Button x:Name="CloseButton" Grid.Column="1" Classes="CloseButton" Click="OnCloseClick" />
        </Grid>
    </Grid>
</Window>
