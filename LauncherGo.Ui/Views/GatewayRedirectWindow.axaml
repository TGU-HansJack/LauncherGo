<Window
    x:Class="LauncherGo.Ui.Views.GatewayRedirectWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:LauncherGo.Ui.Views"
    Width="460"
    SizeToContent="Height"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    Icon="avares://LauncherGo.Ui/Assets/app-icon.ico">
    <Grid Margin="18" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
        <StackPanel Spacing="3">
            <TextBlock x:Name="TitleTextBlock" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="SourceTextBlock" Opacity="0.72" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel x:Name="PlayerPanel" Grid.Row="1" Spacing="5">
            <TextBlock x:Name="PlayerLabelTextBlock" />
            <TextBox x:Name="PlayerTextBox" PlaceholderText="玩家名称或 UID" />
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="5">
            <TextBlock x:Name="TargetLabelTextBlock" />
            <ComboBox x:Name="TargetComboBox" MinHeight="32">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="local:GatewayRedirectTargetItem">
                        <StackPanel Spacing="1">
                            <TextBlock Text="{Binding DisplayName}" />
                            <TextBlock FontSize="11" Opacity="0.7" Text="{Binding ServerId}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <TextBlock x:Name="ErrorTextBlock" Grid.Row="3" Foreground="#D93025" IsVisible="False" TextWrapping="Wrap" />

        <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock x:Name="HintTextBlock" VerticalAlignment="Center" Opacity="0.72" TextWrapping="Wrap" />
            <Button x:Name="CancelButton" Grid.Column="1" MinWidth="76" Click="OnCancelClick" />
            <Button x:Name="ConfirmButton" Grid.Column="2" MinWidth="76" Click="OnConfirmClick" />
        </Grid>
    </Grid>
</Window>
